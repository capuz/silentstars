---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import latestData from '../../data/latest.json';

const ISSUE_URL = 'https://github.com/capuz/silentstars/issues/new?template=submit-project.yml';
const projectCount = latestData.projects.length;

const SAMPLE_SLUGS = [
  'kubernetes-sigs--karpenter-provider-ibm-cloud',
  'hearth-project--hearth',
  'sourcegraph--smoke-tests',
];

const all = await getCollection('projects');
const curated = SAMPLE_SLUGS
  .map(slug => all.find(p => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Fill up to 3 cards when curated slugs have rotated out of the collection:
// promoted (accepted community submissions) first, then most undervalued.
const fallback = all
  .filter(p => p.data.status !== 'archived' && !curated.some(c => c.slug === p.slug))
  .sort((a, b) => {
    const aP = a.data.promoted ? 1 : 0;
    const bP = b.data.promoted ? 1 : 0;
    if (aP !== bP) return bP - aP;
    return b.data.undervaluedScore - a.data.undervaluedScore;
  });
const samples = [...curated, ...fallback].slice(0, 3);
---
<Base
  title="Submit a project"
  description="Know an open source project that deserves more attention? Submit it to SilentStars."
  showMetricsFAQ={false}
>
  <div class="container section">

    <div class="submit-hero">
      <p class="eyebrow">// automated pipeline</p>
      <h1>Submit a project</h1>
      <p class="lead">
        Know something that's actively built but flying under the radar?
        Submit it — the bot validates instantly. If accepted, your project goes live in minutes.
      </p>
      <div class="hero-actions">
        <a href={ISSUE_URL} target="_blank" rel="noopener noreferrer" class="btn-cta">
          Submit your project →
        </a>
        <span class="hero-hint">~1 min · 2 required fields</span>
      </div>
      <p class="count">Joining <strong>{projectCount}</strong> open-source projects already tracked.</p>
    </div>

    <div class="how-section">
      <h2 class="section-label">// how it works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-head">
            <div class="step-num">01</div>
            <svg class="step-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="14" height="17" rx="2" />
              <line x1="7" y1="9" x2="13" y2="9" />
              <line x1="7" y1="13" x2="13" y2="13" />
              <path d="M15.5 17.5l5-5 2 2-5 5-2.5.5z" />
            </svg>
          </div>
          <div class="step-title">Fill a short form</div>
          <p class="step-desc">Repo link + one sentence on why it deserves attention. GitHub hosts the form.</p>
        </div>
        <div class="step">
          <div class="step-head">
            <div class="step-num">02</div>
            <svg class="step-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 11 14 10 22 21 9 13 9 13 2" />
            </svg>
          </div>
          <div class="step-title">Bot validates</div>
          <p class="step-desc">We check activity, stars, open issues, and recent commits. Instant response.</p>
        </div>
        <div class="step">
          <div class="step-head">
            <div class="step-num">03</div>
            <svg class="step-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2" />
              <path d="M12 15l-3-3c.8-2.1 2-4.1 3.5-5.6C15 3.9 18.5 2.5 21.5 2.5c0 3-1.4 6.5-3.9 9-1.5 1.5-3.5 2.7-5.6 3.5z" />
              <path d="M9 12H5.5l2-3.5" />
              <path d="M12 15v3.5l3.5-2" />
              <circle cx="15.5" cy="8.5" r="1" />
            </svg>
          </div>
          <div class="step-title">Goes live</div>
          <p class="step-desc">Accepted projects appear in the directory and get posted on X automatically.</p>
        </div>
        <div class="step">
          <div class="step-head">
            <div class="step-num">04</div>
            <svg class="step-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2.5" y="5" width="19" height="14" rx="2" />
              <path d="M3 6.5l9 7 9-7" />
            </svg>
          </div>
          <div class="step-title">You're notified</div>
          <p class="step-desc">Email with your project card + link to the X post. No need to check back.</p>
        </div>
      </div>
    </div>

    <div class="submit-grid">

      <div class="criteria-card">
        <h2>// what we look for</h2>
        <ul>
          <li><span class="check">✓</span> Commits in the last 90 days</li>
          <li><span class="check">✓</span> Real code, not just a README</li>
          <li><span class="check">✓</span> Open issues being responded to</li>
          <li><span class="check">✓</span> Fewer than 5,000 stars</li>
          <li><span class="x">✗</span> No abandonware or archived repos</li>
          <li><span class="x">✗</span> No repos already viral or trending</li>
          <li><span class="x">✗</span> No self-promotion without substance</li>
        </ul>
      </div>

      <div class="cta-card">
        <h2>// ready?</h2>
        <p>
          No gatekeeping — if the project is real and active, it gets in.
          Accepted projects join the directory and get posted on X automatically.
        </p>
        <a href={ISSUE_URL} target="_blank" rel="noopener noreferrer" class="btn-cta btn-cta-lg">
          Submit your project →
        </a>
        <p class="note">
          Opens a short pre-filled form on GitHub — just the repo link + one sentence. Takes about a minute.
        </p>
        <p class="note">
          Leave your email to get notified when it goes live.
        </p>
      </div>

    </div>

    {samples.length > 0 && (
      <div class="samples-section">
        <h2 class="section-label">// what gets accepted</h2>
        <div class="samples-grid">
          {samples.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
        </div>
      </div>
    )}

  </div>
</Base>

<style>
  .eyebrow {
    font-family: var(--f-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }
  .submit-hero {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
  }
  .submit-hero h1 {
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }
  .lead {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 52ch;
    margin-bottom: 0.75rem;
  }
  .count {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .count strong {
    color: var(--accent);
    font-weight: 700;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 1rem;
  }
  .hero-hint {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  /* ── CTA button (matches home .btn btn-primary) ───────────── */
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    border-radius: 6px;
    border: 1.5px solid var(--ink);
    background: var(--accent);
    color: #fff;
    font-family: var(--f-body);
    font-weight: 700;
    font-size: 14px;
    box-shadow: 3px 3px 0 var(--shadow);
    transition: transform .1s, box-shadow .1s;
    text-decoration: none;
  }
  .btn-cta:hover {
    box-shadow: 1px 1px 0 var(--shadow);
    transform: translate(2px, 2px);
    text-decoration: none;
  }
  .btn-cta-lg {
    padding: 12px 26px;
    font-size: 15px;
    margin-bottom: 1rem;
  }

  /* ── How it works ─────────────────────────────────────────── */
  .how-section {
    margin-bottom: 2.5rem;
  }
  .section-label {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .step {
    background: var(--card);
    padding: 20px 22px;
  }
  .step-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .step-num {
    font-family: var(--f-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .step-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
  .step-title {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
    letter-spacing: 0.02em;
  }
  .step-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 400px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* ── Criteria + CTA ───────────────────────────────────────── */
  .submit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 640px) { .submit-grid { grid-template-columns: 1fr; } }

  .criteria-card, .cta-card {
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--card);
    box-shadow: 2px 2px 0 var(--shadow);
    padding: 24px 28px;
  }
  .criteria-card h2, .cta-card h2 {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }
  .criteria-card ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .criteria-card li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .check { color: #1f9d55; font-weight: 700; font-size: 1rem; }
  .x     { color: #d8392b; font-weight: 700; font-size: 1rem; }

  .cta-card p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .note {
    font-family: var(--f-mono);
    font-size: 0.65rem !important;
    color: var(--text-dim) !important;
    margin-bottom: 0 !important;
  }
  .note + .note { margin-top: 6px; }

  /* ── Sample cards ─────────────────────────────────────────── */
  .samples-section {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }
  .samples-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 800px) { .samples-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .samples-grid { grid-template-columns: 1fr; } }
</style>

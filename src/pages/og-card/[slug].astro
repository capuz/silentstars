---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({
    params: { slug: p.slug },
    props: { data: p.data },
  }));
}

const { data: d } = Astro.props;

const ACCENT = '#e8452e';
const INK    = '#17150f';
const PAPER  = '#f7f5ef';
const MUTED  = '#6b6456';
const SHADOW = '#c9c0af';

const STATUS_MAP: Record<string, { label: string; bg: string }> = {
  newborn:  { label: 'Newborn',  bg: '#bdebd0' },
  thriving: { label: 'Thriving', bg: '#ffe08a' },
  quiet:    { label: 'Quiet',    bg: '#e6e0d2' },
  at_risk:  { label: 'At Risk',  bg: '#ffd5cc' },
  revived:  { label: 'Revived',  bg: '#e8d5f5' },
  watched:  { label: 'Watched',  bg: '#d5eeff' },
  archived: { label: 'Archived', bg: '#e2e0da' },
};

const status = STATUS_MAP[d.status] ?? STATUS_MAP.quiet!;

function healthColor(h: number) {
  if (h >= 80) return '#1f9d55';
  if (h >= 60) return '#c98a1e';
  if (h >= 40) return '#d4691e';
  return '#d8392b';
}

const hColor = healthColor(d.healthScore);
const base   = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1200" />
  <style>
    @font-face {
      font-family: 'Bricolage';
      src: url('/silentstars/fonts/BricolageGrotesque-Bold.ttf') format('truetype');
      font-weight: 700;
    }
    @font-face {
      font-family: 'Bricolage';
      src: url('/silentstars/fonts/BricolageGrotesque-Medium.ttf') format('truetype');
      font-weight: 500;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      width: 1200px;
      height: 630px;
      overflow: hidden;
      background: #f7f5ef;
      font-family: 'Bricolage', system-ui, 'Noto Sans', sans-serif;
    }

    .card {
      width: 1200px;
      height: 630px;
      background: #f7f5ef;
      border: 5px solid #17150f;
      padding: 48px 64px 44px;
      display: flex;
      flex-direction: column;
    }

    /* Top row */
    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .wordmark {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .wordmark-text {
      color: #17150f;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .badge {
      background: var(--badge-bg);
      color: #17150f;
      font-size: 16px;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: 999px;
      border: 1.5px solid #17150f;
      letter-spacing: 0.03em;
    }

    /* Name */
    .name {
      color: #17150f;
      font-size: 68px;
      font-weight: 700;
      line-height: 1.0;
      letter-spacing: -0.03em;
      margin-top: 36px;
      max-width: 1060px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Description */
    .desc {
      color: #6b6456;
      font-size: 26px;
      font-weight: 500;
      line-height: 1.4;
      margin-top: 14px;
      max-width: 960px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Stats */
    .stats {
      display: flex;
      align-items: stretch;
      margin-top: auto;
      margin-bottom: 24px;
      border: 1.5px solid #c9c0af;
      border-radius: 12px;
      overflow: hidden;
    }
    .stat {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 0 16px;
    }
    .stat + .stat {
      border-left: 1.5px solid #c9c0af;
    }
    .stat-value {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .stat-num {
      font-size: 72px;
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1;
    }
    .stat-arrow {
      font-size: 52px;
      font-weight: 700;
      line-height: 1;
      color: #e8452e;
    }
    .stat-label {
      color: #6b6456;
      font-size: 18px;
      font-weight: 500;
      margin-top: 6px;
    }

    /* Footer */
    .footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 18px;
      border-top: 1.5px solid #c9c0af;
    }
    .footer-tagline {
      color: #6b6456;
      font-size: 18px;
      font-weight: 500;
      font-style: italic;
    }
    .footer-url {
      color: #6b6456;
      font-size: 16px;
      font-weight: 500;
    }
  </style>
</head>
<body>
  <div class="card">

    <!-- Top row -->
    <div class="top">
      <div class="wordmark">
        <svg width="30" height="30" viewBox="0 0 24 24">
          <path fill={ACCENT} d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <span class="wordmark-text">SilentStars</span>
      </div>
      <span class="badge" style={`--badge-bg: ${status.bg}`}>{status.label.toUpperCase()}</span>
    </div>

    <!-- Name -->
    <div class="name">{d.name}</div>

    <!-- Description -->
    <div class="desc">{d.description}</div>

    <!-- Stats -->
    <div class="stats">
      <!-- Undervalued -->
      <div class="stat">
        <div class="stat-value">
          <span class="stat-arrow">↑</span>
          <span class="stat-num" style={`color: ${ACCENT}`}>{d.undervaluedScore}</span>
        </div>
        <span class="stat-label">undervalued</span>
      </div>
      <!-- Health -->
      <div class="stat">
        <div class="stat-value">
          <span class="stat-num" style={`color: ${hColor}`}>{d.healthScore}</span>
        </div>
        <span class="stat-label">health</span>
      </div>
      <!-- Stars -->
      <div class="stat">
        <div class="stat-value">
          <svg width="48" height="48" viewBox="0 0 24 24">
            <path fill={INK} d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span class="stat-num" style={`color: ${INK}`}>{d.stars}</span>
        </div>
        <span class="stat-label">stars</span>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <span class="footer-tagline">Not famous. Not abandoned. Just building.</span>
      <span class="footer-url">capuz.github.io/silentstars</span>
    </div>

  </div>
</body>
</html>

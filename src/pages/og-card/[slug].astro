---
import { getCollection } from 'astro:content';
import { resolve } from 'node:path';
import { buildPitch } from '../../../scripts/post-pitch.ts';
import { activityLabel } from '../../../scripts/post-signal.ts';
import { cardImageUrl, coverFit, loadCardImages } from '../../../scripts/readme-image.ts';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const images = loadCardImages(resolve('data/card-images.json'));
  return projects.map(p => ({
    params: { slug: p.slug },
    props: { data: p.data, image: cardImageUrl(p.data.repo, p.data.openGraphImageUrl, images) },
  }));
}

const { data: d, image } = Astro.props;

const STATUS: Record<string, { label: string; bg: string }> = {
  newborn:  { label: 'Newborn',  bg: '#bdebd0' },
  thriving: { label: 'Thriving', bg: '#ffe08a' },
  quiet:    { label: 'Quiet',    bg: '#e6e0d2' },
  at_risk:  { label: 'At risk',  bg: '#ffd5cc' },
  revived:  { label: 'Revived',  bg: '#e8d5f5' },
  watched:  { label: 'Watched',  bg: '#d5eeff' },
  archived: { label: 'Archived', bg: '#e2e0da' },
};

const status = STATUS[d.status] ?? STATUS.quiet!;
const description = buildPitch({ name: d.name, description: d.description, readme: '' });
const detail = [d.language, activityLabel(d, new Date())].filter(Boolean).join(', ');

// The feed shows this card about 300 px wide, so a quarter of every size below is what
// people read. Long names shrink to fit one line, never below the 40 px floor.
const AVERAGE_GLYPH_WIDTH = 0.56;
const fitName = (maxSize: number, width: number) =>
  Math.max(40, Math.min(maxSize, Math.floor(width / (d.name.length * AVERAGE_GLYPH_WIDTH))));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1200" />
  <style>
    @font-face {
      font-family: 'Bricolage';
      src: url('../../fonts/BricolageGrotesque-Bold.ttf') format('truetype');
      font-weight: 700;
    }
    @font-face {
      font-family: 'Bricolage';
      src: url('../../fonts/BricolageGrotesque-Medium.ttf') format('truetype');
      font-weight: 500;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      width: 1200px;
      height: 630px;
      overflow: hidden;
      background: #f7f5ef;
      color: #17150f;
      font-family: 'Bricolage', system-ui, 'Noto Sans CJK SC', 'Noto Sans', sans-serif;
    }

    .card {
      width: 1200px;
      height: 630px;
      border: 5px solid #17150f;
      display: flex;
      flex-direction: column;
    }

    .cover {
      flex: 1;
      min-height: 0;
      border-bottom: 5px solid #17150f;
      background: #17150f;
    }
    .cover {
      position: relative;
      overflow: hidden;
    }
    .cover img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-position: top;
    }
    .cover-fill {
      object-fit: cover;
      object-position: center;
      filter: blur(36px) saturate(1.15);
      transform: scale(1.2);
    }
    .cover-main[data-fit='cover'] { object-fit: cover; }
    .cover-main[data-fit='contain'] { object-fit: contain; object-position: center; }

    .lead {
      flex: 1;
      min-height: 0;
      padding: 44px 48px 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 16px;
    }
    .lead-name, .strip-name {
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.05;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lead-desc {
      color: #6b6456;
      font-size: 44px;
      font-weight: 500;
      line-height: 1.22;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .strip {
      flex: none;
      display: flex;
      align-items: center;
      gap: 28px;
      padding: 18px 40px 20px;
    }
    .strip-text {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .meta {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
    }
    .status {
      flex: none;
      background: var(--status-bg);
      border: 3px solid #17150f;
      border-radius: 999px;
      font-size: 34px;
      font-weight: 700;
      line-height: 1;
      padding: 5px 20px 8px;
    }
    .detail {
      color: #6b6456;
      font-size: 40px;
      font-weight: 500;
      line-height: 1.1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .star {
      flex: none;
      width: 104px;
      height: 104px;
      image-rendering: pixelated;
    }

    body[data-variant='image'] .lead { display: none; }
    body[data-variant='text'] .cover,
    body[data-variant='text'] .strip-name { display: none; }
  </style>
</head>
<body data-variant={image ? 'image' : 'text'}>
  <div class="card">
    {image && (
      <div class="cover">
        {coverFit(image) === 'contain' && <img class="cover-fill" src={image} alt="" />}
        <img class="cover-main" data-fit={coverFit(image)} src={image} alt="" />
      </div>
    )}

    <div class="lead">
      <div class="lead-name" style={`font-size: ${fitName(112, 1090)}px`}>{d.name}</div>
      {description && <div class="lead-desc">{description}</div>}
    </div>

    <div class="strip">
      <div class="strip-text">
        <div class="strip-name" style={`font-size: ${fitName(64, 920)}px`}>{d.name}</div>
        <div class="meta">
          <span class="status" style={`--status-bg: ${status.bg}`}>{status.label}</span>
          {detail && <span class="detail">{detail}</span>}
        </div>
      </div>
      <img class="star" src="../../logo-star.png" alt="" />
    </div>
  </div>
</body>
</html>

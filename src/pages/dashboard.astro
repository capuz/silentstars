---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = await getCollection('projects');
const projects = all.filter(p => p.data.status !== 'archived');

const base = import.meta.env.BASE_URL;

// ── Aggregate stats ────────────────────────────────────────────
const total      = projects.length;
const avgHealth  = Math.round(projects.reduce((s, p) => s + p.data.healthScore, 0) / total);
const avgUnder   = Math.round(projects.reduce((s, p) => s + p.data.undervaluedScore, 0) / total);
const totalStars = projects.reduce((s, p) => s + p.data.stars, 0);

// ── Undervalued Score histogram (buckets 0–9, 10–19, …, 90–100) ──
const uBuckets = Array(10).fill(0) as number[];
projects.forEach(p => {
  const i = Math.min(Math.floor(p.data.undervaluedScore / 10), 9);
  uBuckets[i]++;
});
const uMax = Math.max(...uBuckets);

// ── Health Score histogram (buckets 0–9, …, 90–100) ──
const hBuckets = Array(10).fill(0) as number[];
projects.forEach(p => {
  const i = Math.min(Math.floor(p.data.healthScore / 10), 9);
  hBuckets[i]++;
});
const hMax = Math.max(...hBuckets);

// ── Status distribution ────────────────────────────────────────
const statusCount: Record<string, number> = {};
projects.forEach(p => {
  statusCount[p.data.status] = (statusCount[p.data.status] ?? 0) + 1;
});
const statusOrder = ['thriving', 'newborn', 'revived', 'watched', 'quiet', 'at_risk'];
const statusLabels: Record<string, string> = {
  thriving: 'Thriving', newborn: 'Newborn', revived: 'Revived',
  watched: 'Watched', quiet: 'Quiet', at_risk: 'At Risk',
};
const statusColors: Record<string, string> = {
  thriving: '#1f9d55', newborn: '#2563eb', revived: '#7c3aed',
  watched: '#0284c7', quiet: '#ca8a04', at_risk: '#dc2626',
};
const statusMax = Math.max(...Object.values(statusCount));

// ── Language distribution (top 10) ────────────────────────────
const langCount: Record<string, number> = {};
projects.forEach(p => {
  if (p.data.language) langCount[p.data.language] = (langCount[p.data.language] ?? 0) + 1;
});
const topLangs = Object.entries(langCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
const langMax = topLangs[0]?.[1] ?? 1;

// ── Tag distribution ───────────────────────────────────────────
const tagCount: Record<string, number> = {};
projects.forEach(p => p.data.tags.forEach(t => {
  tagCount[t] = (tagCount[t] ?? 0) + 1;
}));
const tagLabels: Record<string, string> = {
  solo_builder:       'Solo builder',
  needs_contributors: 'Help wanted',
  hidden_gem:         'Hidden gem',
  legacy_hero:        'Legacy hero',
  community_watch:    'Community watch',
  funded:             'Funded',
  release_machine:    'Release machine',
  under_pressure:     'Under pressure',
  community_hub:      'Community hub',
  fork_magnet:        'Fork magnet',
};
const topTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
const tagMax = topTags[0]?.[1] ?? 1;

// ── Top 10 by undervalued score ────────────────────────────────
const top10 = [...projects]
  .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore)
  .slice(0, 10);

// ── SVG histogram helpers ──────────────────────────────────────
const SVG_W = 560;
const SVG_H = 160;
const PAD_L = 32;
const PAD_B = 28;
const CHART_W = SVG_W - PAD_L - 8;
const CHART_H = SVG_H - PAD_B - 8;
const BAR_W = Math.floor(CHART_W / 10) - 3;

function barX(i: number) { return PAD_L + i * (CHART_W / 10) + 2; }
function barH(count: number, max: number) { return Math.round((count / max) * CHART_H); }
function barY(count: number, max: number) { return 8 + CHART_H - barH(count, max); }

// Pre-compute bar data to avoid < in JSX ternaries
function uColor(i: number): string {
  const mid = i * 10 + 5;
  if (mid < 30) return '#2563eb';
  if (mid <= 60) return '#ca8a04';
  return '#ff5436';
}
function hColor(i: number): string {
  const mid = i * 10 + 5;
  if (mid < 40) return '#d8392b';
  if (mid < 60) return '#d4691e';
  if (mid < 80) return '#c98a1e';
  return '#1f9d55';
}

const uBars = uBuckets.map((count, i) => ({
  count, x: barX(i), h: barH(count, uMax), y: barY(count, uMax),
  fill: uColor(i), label: String(i * 10),
}));
const hBars = hBuckets.map((count, i) => ({
  count, x: barX(i), h: barH(count, hMax), y: barY(count, hMax),
  fill: hColor(i), label: String(i * 10),
}));
---
<Base title="Dashboard" description="Métricas y estadísticas del directorio SilentStars" showMetricsFAQ={false}>
  <div class="container section">

    <header class="dash-header">
      <h1 class="dash-title">// dashboard</h1>
      <p class="dash-sub">Métricas del directorio — {total} proyectos activos</p>
    </header>

    <!-- ── 1. Hero stats ── -->
    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-num">{total}</span>
        <span class="stat-label">proyectos activos</span>
      </div>
      <div class="stat-card">
        <span class="stat-num" style="color:#1f9d55">{avgHealth}</span>
        <span class="stat-label">health score promedio</span>
      </div>
      <div class="stat-card">
        <span class="stat-num" style="color:var(--accent)">{avgUnder}</span>
        <span class="stat-label">undervalued score promedio</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">★ {totalStars.toLocaleString()}</span>
        <span class="stat-label">estrellas totales</span>
      </div>
    </div>

    <!-- ── 2. Undervalued Score ── -->
    <section class="dash-section">
      <div class="section-head">
        <h2 class="section-title">Undervalued Score</h2>
        <p class="section-desc">
          Mide cuánto hace un proyecto en relación a lo famoso que es.
          Fórmula: <code>señal ÷ alcance</code>, donde señal combina velocidad de commits,
          colaboradores activos, resolución de issues, cadencia de releases y ratio forks/estrellas.
          El alcance es <code>log₁₀(stars + watchers)</code>.
        </p>
        <div class="score-legend">
          <span class="legend-item" style="--c:#2563eb">◼ &lt;30 bien conocido</span>
          <span class="legend-item" style="--c:#ca8a04">◼ 30–60 equilibrado</span>
          <span class="legend-item" style="--c:var(--accent)">◼ &gt;60 joya oculta</span>
        </div>
      </div>

      <div class="chart-wrap">
        <svg viewBox={`0 0 ${SVG_W} ${SVG_H}`} class="histogram" aria-label="Distribución del Undervalued Score">
          {[0.25, 0.5, 0.75, 1].map(f => (
            <line x1={PAD_L} y1={8 + CHART_H - f * CHART_H} x2={SVG_W - 8} y2={8 + CHART_H - f * CHART_H} stroke="currentColor" stroke-width="0.5" opacity="0.15" />
          ))}
          {uBars.map(b => b.count > 0 && (
            <g>
              <rect x={b.x} y={b.y} width={BAR_W} height={b.h} fill={b.fill} rx="2" opacity="0.85" />
              <text x={b.x + BAR_W / 2} y={b.y - 4} text-anchor="middle" font-size="9" fill="currentColor" opacity="0.7">{b.count}</text>
            </g>
          ))}
          {uBars.map(b => (
            <text x={b.x + BAR_W / 2} y={SVG_H - 6} text-anchor="middle" font-size="9" fill="currentColor" opacity="0.55">{b.label}</text>
          ))}
          <line x1={PAD_L} y1={8 + CHART_H} x2={SVG_W - 8} y2={8 + CHART_H} stroke="currentColor" stroke-width="1" opacity="0.3" />
        </svg>
      </div>
    </section>

    <!-- ── 3. Health Score ── -->
    <section class="dash-section">
      <div class="section-head">
        <h2 class="section-title">Health Score</h2>
        <p class="section-desc">
          Mide qué tan activamente mantenido está el proyecto. Compuesto por 4 factores:
          <strong>recencia</strong> del último commit (35 pts), <strong>cadencia</strong> de commits
          (25 pts), <strong>resolución de issues</strong> cerrados/total (20 pts), y
          <strong>salud de PRs</strong> mergeados/total (20 pts).
        </p>
        <div class="score-legend">
          <span class="legend-item" style="--c:#d8392b">◼ &lt;40 en riesgo</span>
          <span class="legend-item" style="--c:#d4691e">◼ 40–60 tranquilo</span>
          <span class="legend-item" style="--c:#c98a1e">◼ 60–80 estable</span>
          <span class="legend-item" style="--c:#1f9d55">◼ &gt;80 saludable</span>
        </div>
      </div>

      <div class="chart-wrap">
        <svg viewBox={`0 0 ${SVG_W} ${SVG_H}`} class="histogram" aria-label="Distribución del Health Score">
          {[0.25, 0.5, 0.75, 1].map(f => (
            <line x1={PAD_L} y1={8 + CHART_H - f * CHART_H} x2={SVG_W - 8} y2={8 + CHART_H - f * CHART_H} stroke="currentColor" stroke-width="0.5" opacity="0.15" />
          ))}
          {hBars.map(b => b.count > 0 && (
            <g>
              <rect x={b.x} y={b.y} width={BAR_W} height={b.h} fill={b.fill} rx="2" opacity="0.85" />
              <text x={b.x + BAR_W / 2} y={b.y - 4} text-anchor="middle" font-size="9" fill="currentColor" opacity="0.7">{b.count}</text>
            </g>
          ))}
          {hBars.map(b => (
            <text x={b.x + BAR_W / 2} y={SVG_H - 6} text-anchor="middle" font-size="9" fill="currentColor" opacity="0.55">{b.label}</text>
          ))}
          <line x1={PAD_L} y1={8 + CHART_H} x2={SVG_W - 8} y2={8 + CHART_H} stroke="currentColor" stroke-width="1" opacity="0.3" />
        </svg>
      </div>
    </section>

    <!-- ── 4 + 5. Status + Languages (2-col) ── -->
    <div class="two-col">

      <!-- Status -->
      <section class="dash-section dash-panel">
        <h2 class="section-title">Estado</h2>
        <div class="bar-list">
          {statusOrder.filter(s => statusCount[s] > 0).map(s => (
            <div class="bar-row">
              <span class="bar-key" style={`color:${statusColors[s]}`}>{statusLabels[s]}</span>
              <div class="bar-track">
                <div class="bar-fill" style={`width:${((statusCount[s] ?? 0) / statusMax * 100).toFixed(1)}%;background:${statusColors[s]}`} />
              </div>
              <span class="bar-val">{statusCount[s] ?? 0}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Languages -->
      <section class="dash-section dash-panel">
        <h2 class="section-title">Lenguajes (top 10)</h2>
        <div class="bar-list">
          {topLangs.map(([lang, count]) => (
            <div class="bar-row">
              <span class="bar-key">{lang}</span>
              <div class="bar-track">
                <div class="bar-fill" style={`width:${(count / langMax * 100).toFixed(1)}%;background:var(--accent2)`} />
              </div>
              <span class="bar-val">{count}</span>
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- ── 6. Tags ── -->
    <section class="dash-section dash-panel">
      <h2 class="section-title">Tags</h2>
      <div class="bar-list bar-list--wide">
        {topTags.map(([tag, count]) => (
          <div class="bar-row">
            <span class="bar-key">// {tagLabels[tag] ?? tag}</span>
            <div class="bar-track">
              <div class="bar-fill" style={`width:${(count / tagMax * 100).toFixed(1)}%;background:var(--ink)`} />
            </div>
            <span class="bar-val">{count}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 7. Top 10 por Undervalued Score ── -->
    <section class="dash-section dash-panel">
      <h2 class="section-title">Top 10 — más infravalorados</h2>
      <p class="section-desc">Proyectos con mayor actividad relativa a su visibilidad.</p>
      <table class="top-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Proyecto</th>
            <th title="Undervalued Score">↑ score</th>
            <th title="Health Score">health</th>
            <th>★</th>
            <th>lang</th>
          </tr>
        </thead>
        <tbody>
          {top10.map((p, i) => (
            <tr>
              <td class="rank">{i + 1}</td>
              <td>
                <a href={`${base}projects/${p.slug}/`} class="proj-link">
                  {p.data.name}
                  <span class="proj-repo">{p.data.repo}</span>
                </a>
              </td>
              <td class="score-cell accent">{p.data.undervaluedScore}</td>
              <td class="score-cell health">{p.data.healthScore}</td>
              <td class="score-cell">{p.data.stars}</td>
              <td class="lang-cell">{p.data.language ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

  </div>
</Base>

<style>
  /* ── Layout ── */
  .dash-header { margin-bottom: 1.75rem; }
  .dash-title {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .dash-sub {
    font-family: var(--f-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* ── Hero stat cards ── */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 2rem;
  }
  @media (max-width: 680px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px 14px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--card);
    box-shadow: 2px 2px 0 var(--shadow);
    text-align: center;
    gap: 4px;
  }
  .stat-num {
    font-family: var(--f-display);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stat-label {
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ── Sections ── */
  .dash-section { margin-bottom: 1.75rem; }
  .dash-panel {
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--card);
    box-shadow: 2px 2px 0 var(--shadow);
    padding: 18px 20px;
  }

  .section-head { margin-bottom: 16px; }
  .section-title {
    font-family: var(--f-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .section-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 70ch;
    margin-bottom: 10px;
  }
  .section-desc code {
    font-family: var(--f-mono);
    font-size: 11px;
    background: var(--bg-code);
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* ── Score legend ── */
  .score-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 700;
  }
  .legend-item { color: var(--c, var(--muted)); }

  /* ── SVG histogram ── */
  .chart-wrap {
    border: 1.5px solid var(--faint);
    border-radius: 6px;
    padding: 10px 8px 4px;
    background: var(--card);
  }
  .histogram {
    width: 100%;
    height: auto;
    color: var(--ink);
    font-family: var(--f-mono);
    display: block;
  }

  /* ── Two-col layout ── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 1.75rem;
  }
  @media (max-width: 680px) { .two-col { grid-template-columns: 1fr; } }

  /* ── Horizontal bar list ── */
  .bar-list { display: flex; flex-direction: column; gap: 7px; margin-top: 14px; }
  .bar-row {
    display: grid;
    grid-template-columns: 130px 1fr 36px;
    align-items: center;
    gap: 8px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
  }
  .bar-list--wide .bar-row { grid-template-columns: 160px 1fr 36px; }

  .bar-key { color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar-track {
    height: 10px;
    border-radius: 999px;
    background: var(--faint);
    overflow: hidden;
  }
  .bar-fill { height: 100%; border-radius: 999px; transition: width .2s; }
  .bar-val { color: var(--muted); text-align: right; }

  /* ── Top table ── */
  .top-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--f-mono);
    font-size: 11.5px;
    margin-top: 14px;
  }
  .top-table th {
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding: 0 8px 8px 0;
    border-bottom: 1.5px solid var(--faint);
    white-space: nowrap;
  }
  .top-table td {
    padding: 8px 8px 8px 0;
    border-bottom: 1px solid var(--faint);
    vertical-align: middle;
  }
  .top-table tr:last-child td { border-bottom: none; }

  .rank { color: var(--muted); width: 20px; }

  .proj-link {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-weight: 700;
    transition: color .12s;
  }
  .proj-link:hover { color: var(--accent); text-decoration: none; }
  .proj-repo { font-size: 10px; color: var(--muted); font-weight: 400; }

  .score-cell {
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
    padding-right: 16px !important;
  }
  .score-cell.accent { color: var(--accent); }
  .score-cell.health { color: #1f9d55; }
  .lang-cell { color: var(--muted); }
</style>

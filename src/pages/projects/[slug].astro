---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import VitalityBar from '../../components/VitalityBar.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await project.render();
const d = project.data;

function relativeDate(iso: string) {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  if (days === 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30) return `${days}d ago`;
  const months = Math.floor(days / 30);
  if (months < 12) return `${months}mo ago`;
  const years = Math.floor(months / 12);
  return `${years}y ago`;
}

function ageLabel(iso: string) {
  const months = Math.floor((Date.now() - new Date(iso).getTime()) / (30 * 86_400_000));
  if (months < 1) return '< 1 month';
  if (months < 12) return `${months}mo`;
  const years = Math.floor(months / 12);
  const rem = months % 12;
  return `${years}y${rem > 0 ? ` ${rem}mo` : ''}`;
}

const tagLabels: Record<string, string> = {
  solo_builder:       '// solo builder',
  needs_contributors: '// help wanted',
  hidden_gem:         '// hidden gem',
  legacy_hero:        '// legacy hero',
};

const base = import.meta.env.BASE_URL;
---
<Base title={d.name} description={d.description}>
  <div class="container section">
    <nav class="breadcrumb">
      <a href={`${base}projects`}>← directory</a>
    </nav>

    <header class="proj-header">
      <div class="proj-title-row">
        <h1 class="proj-name">{d.name}</h1>
        {d.language && <span class="lang">{d.language}</span>}
      </div>
      <p class="proj-repo">
        <a href={d.url} target="_blank" rel="noopener">{d.repo}</a>
      </p>
      <p class="proj-desc">{d.description}</p>
      {d.homepage && (
        <p class="proj-homepage">
          <a href={d.homepage} target="_blank" rel="noopener">{d.homepage}</a>
        </p>
      )}
    </header>

    <div class="layout">
      <!-- Sidebar: metadata in spec-defined order -->
      <aside class="sidebar">

        <!-- 1. Estado -->
        <div class="meta-row">
          <span class="meta-label">status</span>
          <StatusBadge status={d.status} />
        </div>

        {d.status === 'revived' && d.revivedAfterMonths && d.revivedDaysAgo && (
          <div class="revived-note">
            ↻ inactive {d.revivedAfterMonths}mo → back {d.revivedDaysAgo}d ago
          </div>
        )}

        <!-- 2. Last commit -->
        <div class="meta-row">
          <span class="meta-label">last commit</span>
          <span class="meta-val">{relativeDate(d.lastCommitAt)}</span>
        </div>

        <!-- 3. Latest release -->
        <div class="meta-row">
          <span class="meta-label">latest release</span>
          <span class="meta-val">{d.lastReleaseAt ? relativeDate(d.lastReleaseAt) : '—'}</span>
        </div>

        <!-- 4. Maintainers -->
        <div class="meta-row">
          <span class="meta-label">maintainers</span>
          <span class="meta-val">{d.maintainers.length > 0 ? d.maintainers.join(', ') : '—'}</span>
        </div>

        <!-- 5. Age -->
        <div class="meta-row">
          <span class="meta-label">age</span>
          <span class="meta-val">{ageLabel(d.createdAt)}</span>
        </div>

        <!-- 6. Open issues -->
        <div class="meta-row">
          <span class="meta-label">open issues</span>
          <span class="meta-val">{d.openIssues}</span>
        </div>

        <!-- 7. Forks -->
        <div class="meta-row">
          <span class="meta-label">forks</span>
          <span class="meta-val">{d.forks}</span>
        </div>

        <!-- Vitality -->
        <div class="meta-vitality">
          <span class="meta-label">vitality</span>
          <VitalityBar score={d.vitalityScore} />
        </div>

        <!-- Attention Gap -->
        <div class="meta-row">
          <span class="meta-label">attention gap</span>
          <span class="meta-val meta-gap">↑ {d.attentionGap.toFixed(1)}</span>
        </div>

        <!-- Tags -->
        {d.tags.length > 0 && (
          <div class="meta-tags">
            {d.tags.map(t => <span class="tag">{tagLabels[t] ?? t}</span>)}
          </div>
        )}

        <!-- Stars — last, small, by design -->
        <div class="meta-row meta-stars">
          <span class="meta-label">stars</span>
          <a href={d.url} target="_blank" rel="noopener" class="stars-link">★ {d.stars}</a>
        </div>
      </aside>

      <!-- Main: rendered markdown -->
      <article class="prose">
        <Content />
        <div class="proj-cta">
          <a href={d.url} target="_blank" rel="noopener" class="btn-primary">
            View on GitHub ↗
          </a>
        </div>
      </article>
    </div>
  </div>
</Base>

<style>
  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-bottom: 2rem;
    letter-spacing: 0.02em;
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--text); text-decoration: none; }

  .proj-header { margin-bottom: 2.5rem; }
  .proj-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .proj-name {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .lang {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 0.15em 0.5em;
    border-radius: 2px;
  }
  .proj-repo {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }
  .proj-repo a { color: var(--text-muted); text-decoration: underline; }
  .proj-desc { color: var(--text-muted); line-height: 1.7; max-width: 62ch; }
  .proj-homepage {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    margin-top: 0.5rem;
  }
  .proj-homepage a { color: var(--text-dim); text-decoration: underline; }

  /* Layout */
  .layout {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 680px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { order: 1; }
    article { order: 0; }
  }

  /* Sidebar */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: sticky;
    top: 68px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.65rem 0.875rem;
    border-bottom: 1px solid var(--border);
  }
  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    text-transform: lowercase;
  }
  .meta-val {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .meta-gap { color: var(--revived); font-weight: 700; }

  .meta-vitality {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.65rem 0.875rem;
    border-bottom: 1px solid var(--border);
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.65rem 0.875rem;
    border-bottom: 1px solid var(--border);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
  }

  .meta-stars { opacity: 0.45; }
  .stars-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .revived-note {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--revived);
    border-left: 2px solid var(--revived);
    padding: 0.4em 0.75em;
    margin: 0;
    background: rgba(199, 125, 255, 0.06);
  }

  /* Prose */
  .prose {
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 0.95rem;
  }
  .prose :global(p) { margin-bottom: 1rem; }
  .prose :global(h2), .prose :global(h3) {
    font-family: var(--font-mono);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text);
    font-size: 1rem;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    background: #1e1b27;
    padding: 0.1em 0.4em;
    border-radius: 2px;
    font-size: 0.85em;
    color: var(--text);
  }
  .prose :global(pre) {
    background: #1e1b27;
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
  }

  .proj-cta { margin-top: 2.5rem; }
  .btn-primary {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--text);
    color: var(--bg);
    padding: 0.6em 1.4em;
    border-radius: var(--radius);
    transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; text-decoration: none; }
</style>

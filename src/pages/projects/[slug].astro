---
import { langIconUrl } from '../../lib/lang-icons.ts';
import { withRef } from '../../lib/ref.ts';
import ScoreHelp from '../../components/ScoreHelp.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { postedFor } from '../../lib/posted.ts';
import { isExcludedOwner, isListable } from '../../../scripts/discovery-filter.ts';
import ProjectCard from '../../components/ProjectCard.astro';
import WeeklySpark from '../../components/WeeklySpark.astro';
import { listEditions, projectSeries, isoWeekKey, type History, type ProjectSeries } from '../../../scripts/weekly.ts';
import { editionsByRepo, starsSince, whyItsHere, helpLinks, relatedProjects, type FeaturedIn } from '../../../scripts/project-insights.ts';
import historyJson from '../../../data/history.json';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // Computed once for all pages, not once per page.
  const history = historyJson as History;
  const latestWeek = Object.keys(history).sort().at(-1) ?? '';
  const featuredIdx = editionsByRepo(listEditions(history, new Date()));
  const listable = projects
    .filter(p => isListable(p.data.repo, p.data.stars) && p.data.description.trim() !== '')
    .map(p => ({ ...p.data, slug: p.slug }));
  return projects.map(p => ({
    params: { slug: p.slug },
    props: {
      project: p,
      series: latestWeek ? projectSeries(history, p.data.repo, latestWeek) : null,
      featuredIn: featuredIdx.get(p.data.repo) ?? [],
      related: relatedProjects(p.data, listable, 4),
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  series: ProjectSeries | null;
  featuredIn: FeaturedIn[];
  related: Array<CollectionEntry<'projects'>['data'] & { slug: string }>;
}
const { project, series, featuredIn, related } = Astro.props;
const { Content } = await project.render();
const d = project.data;

// ── Category badge (same as ProjectCard) ──────────────────────
const catMap: Record<string, { label: string; bg: string; path: string }> = {
  newborn:  { label: 'Newborn',  bg: '#bdebd0',
    path: '<path d="M12 21v-8"/><path d="M12 13C12 9 9 6.5 5 6.5 5 10.5 8 13 12 13z"/><path d="M12 13.5c0-3.5 2.6-6 6-6 0 3.5-2.6 6-6 6z"/>' },
  thriving: { label: 'Thriving', bg: '#ffe08a',
    path: '<path d="M3 17l6-6 4 4 8-8"/><path d="M17 7h4v4"/>' },
  quiet:    { label: 'Quiet',    bg: '#e6e0d2',
    path: '<path d="M21 12.8A8 8 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8z"/>' },
  at_risk:  { label: 'At Risk',  bg: '#ffd5cc',
    path: '<path d="M12 9v4m0 3h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>' },
  revived:  { label: 'Revived',  bg: '#e8d5f5',
    path: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>' },
  watched:  { label: 'Watched',  bg: '#d5eeff',
    path: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>' },
  archived: { label: 'Archived', bg: '#e2e0da',
    path: '<rect x="2" y="4" width="20" height="5" rx="2"/><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"/><path d="M10 13h4"/>' },
};
const cat = catMap[d.status] ?? catMap.quiet!;
const catIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#17150f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${cat.path}</svg>`;
const catIconSrc = `data:image/svg+xml,${encodeURIComponent(catIconSvg)}`;

// ── Language chip ──────────────────────────────────────────────
const langCodes: Record<string, string> = {
  TypeScript: 'TS', JavaScript: 'JS', Python: 'PY', Go: 'GO', Rust: 'RS',
  Ruby: 'RB', Java: 'JV', Kotlin: 'KT', Swift: 'SW', 'C++': 'C+', 'C#': 'C#',
  PHP: 'PH', Dart: 'DA', Scala: 'SC', Haskell: 'HS', Lua: 'LU', Elixir: 'EX',
  Zig: 'ZG', Shell: 'SH', HTML: 'HT', CSS: 'CS', Vue: 'VU', Svelte: 'SV',
  Clojure: 'CL', Julia: 'JL', C: 'C ',
};
const langIcon  = langIconUrl(d.language);
const langCode  = d.language ? (langCodes[d.language] ?? d.language.slice(0, 2).toUpperCase()) : null;
const lang1Pct  = d.languagePcts?.[0] ?? null;

const secondaryLang = d.languages?.[1] && d.languages[1] !== d.language ? d.languages[1] : null;
const lang2Icon = langIconUrl(secondaryLang);
const lang2Code = secondaryLang ? (langCodes[secondaryLang] ?? secondaryLang.slice(0, 2).toUpperCase()) : null;
const lang2Pct  = d.languagePcts?.[1] ?? null;

// ── Health ─────────────────────────────────────────────────────
function healthMeta(h: number) {
  if (h >= 80) return { color: '#1f9d55', label: 'Healthy' };
  if (h >= 60) return { color: '#c98a1e', label: 'Stable' };
  if (h >= 40) return { color: '#d4691e', label: 'Quiet' };
  return         { color: '#d8392b', label: 'At Risk' };
}
const { color: hColor, label: hLabel } = healthMeta(d.healthScore);

// ── Meta helpers ───────────────────────────────────────────────
function relDate(iso: string) {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  if (days === 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30)  return `${days}d ago`;
  const mo = Math.floor(days / 30);
  if (mo < 12)    return `${mo}mo ago`;
  return `${Math.floor(mo / 12)}y ago`;
}
function mmyyyy(iso: string) {
  const d = new Date(iso);
  return `${String(d.getMonth()+1).padStart(2,'0')}-${d.getFullYear()}`;
}
function fullDateTime(iso: string) {
  const dt = new Date(iso);
  const date = `${dt.getUTCFullYear()}-${String(dt.getUTCMonth()+1).padStart(2,'0')}-${String(dt.getUTCDate()).padStart(2,'0')}`;
  const h = dt.getUTCHours();
  const m = dt.getUTCMinutes();
  if (h === 0 && m === 0) return date;
  return `${date} ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
}

const daysSince = Math.floor((Date.now() - new Date(d.lastCommitAt).getTime()) / 86_400_000);
const age       = daysSince === 0 ? 'today' : daysSince === 1 ? '1d ago' : `${daysSince}d ago`;
const author    = d.maintainers[0] ?? d.repo.split('/')[0];
const authorUrl = `https://github.com/${author}`;

const tagLabels: Record<string, string> = {
  solo_builder:       'solo builder',
  needs_contributors: 'help wanted',
  hidden_gem:         'hidden gem',
  legacy_hero:        'legacy hero',
  community_watch:    'community watch',
  funded:             'funded',
  release_machine:    'release machine',
  under_pressure:     'under pressure',
  community_hub:      'community hub',
  fork_magnet:        'fork magnet',
};

const base    = import.meta.env.BASE_URL;
// Daily-highlight post published for this project (recorded by the post job)
const postedEntry = postedFor(project.slug);
const bskyPostUrl = withRef(postedEntry?.platforms.bsky?.url);
// posted.json is checked too: the frontmatter postedAt only lands at the next
// collect, but the og/<slug>.png exists from the build that posted it.
const ogImage = d.postedAt || postedEntry
  ? new URL(`${base}og/${project.slug}.png`, Astro.site).href
  : new URL(`${base}og/index.png`, Astro.site).href;
const customImage = d.openGraphImageUrl?.includes('repository-images.githubusercontent.com')
  ? d.openGraphImageUrl : null;
const pageUrl = new URL(`${base}projects/${project.slug}/`, Astro.site).href;
// Description and README were machine-translated (scripts/collect-i18n.ts).
const translatedFrom = d.descriptionLang
  ? (new Intl.DisplayNames(['en'], { type: 'language' }).of(d.descriptionLang) ?? d.descriptionLang)
  : null;
const shareText = encodeURIComponent(`★ ${d.name} — ${d.description}\n\n${pageUrl}`);
const shareUrl  = withRef(`https://bsky.app/intent/compose?text=${shareText}`);

// ── Insights (scripts/project-insights.ts) ────────────────────
const featuredAt = d.postedAt ?? postedEntry?.postedAt;
const sinceFeatured = featuredAt
  ? starsSince(historyJson as History, d.repo, isoWeekKey(new Date(featuredAt)), d.stars)
  : null;
const featuredDate = featuredAt ? featuredAt.slice(0, 10) : null;
const sectionLabels = { newcomers: 'new', rising: 'rising', revived: 'back' } as const;
const why  = whyItsHere(d);
const help = helpLinks(d);
---
<Base title={d.name} description={d.description} ogImage={ogImage} noindex={isExcludedOwner(d.repo)}>
  <div class="container section">

    <nav class="breadcrumb">
      <a href={`${base}projects/`}>← directory</a>
    </nav>

    <!-- ── Hero card (same visual language as ProjectCard) ── -->
    <article class="hero-card">

      {customImage && (
        <div class="hero-thumb">
          <img src={customImage} alt={d.name} loading="eager" decoding="async" />
        </div>
      )}

      <!-- top row -->
      <div class="card-top">
        <div class="card-badges">
          <span class="cat-badge" style={`background:${cat.bg};`}>
            <img src={catIconSrc} alt={cat.label} width="16" height="16" />
            {cat.label}
          </span>
          {d.language && langCode && (
            <span class="lang-chip" title={lang1Pct ? `${d.language} ${lang1Pct}%` : d.language}>
              {langIcon && (
                <img src={langIcon} alt={d.language} width="16" height="16"
                  onerror="this.style.display='none'" />
              )}
              {langCode}
            </span>
          )}
          {secondaryLang && lang2Code && (
            <span class="lang-chip lang-chip--secondary"
                  title={lang2Pct ? `${secondaryLang} ${lang2Pct}%` : secondaryLang}>
              {lang2Icon && (
                <img src={lang2Icon} alt={secondaryLang} width="16" height="16"
                  onerror="this.style.display='none'" />
              )}
              {lang2Code}
            </span>
          )}
        </div>
        <div class="card-score" title="Undervalued score">
          <span class="score-arrow">↑</span>
          <span class="score-num">{d.undervaluedScore}</span>
          <ScoreHelp topic="undervalued" label="What is the Undervalued Score?" />
        </div>
      </div>

      <!-- name + repo -->
      <a href={withRef(d.url)} target="_blank" rel="noopener" class="card-name">{d.name}</a>
      <span class="card-slug">{d.repo}</span>

      <!-- description -->
      <p class="card-desc">{d.description}</p>
      {translatedFrom && (
        <p class="card-translated">
          Translated from {translatedFrom} by Claude ·
          <a href={withRef(d.url)} target="_blank" rel="noopener">original on GitHub ↗</a>
        </p>
      )}

      {d.homepage && (
        <a href={d.homepage} target="_blank" rel="noopener" class="card-homepage">
          {d.homepage} ↗
        </a>
      )}

      <!-- health bar -->
      <div class="health-wrap">
        <div class="health-header">
          <span class="health-label-text">HEALTH <ScoreHelp topic="health" label="What is the Health Score?" /></span>
          <span class="health-value" style={`color:${hColor};`}>{d.healthScore} / {hLabel}</span>
        </div>
        <div class="health-track">
          <div class="health-fill" style={`width:${d.healthScore}%;background:${hColor};`}></div>
        </div>
      </div>

      <!-- tags -->
      {(d.tags.length > 0 || (d.topics && d.topics.length > 0)) && (
        <div class="card-tags">
          {d.tags.map(t => <span class="tag">// {tagLabels[t] ?? t}</span>)}
          {d.topics?.map(t => <span class="tag tag--topic">{t}</span>)}
          <ScoreHelp topic="tags" label="What do these tags mean?" />
        </div>
      )}

      <!-- footer -->
      <div class="card-footer">
        <span class="footer-meta">
          {d.createdAt && (
            <>
              <span class="meta-since">{mmyyyy(d.createdAt)}</span>
              <span class="meta-dot">·</span>
            </>
          )}
          <span class="meta-age">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5l3 2"/></svg>
            {age}
          </span>
          <span class="meta-dot">·</span>
          <a href={authorUrl} target="_blank" rel="noopener" class="meta-author">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M5.5 20c0-3.4 2.9-5.8 6.5-5.8s6.5 2.4 6.5 5.8"/></svg>
            {author}
          </a>
        </span>
        <div class="footer-right">
          <a href={withRef(d.url)} target="_blank" rel="noopener" class="footer-stars">
            <span>★</span>{d.stars}
          </a>
          {bskyPostUrl && (
            <a href={bskyPostUrl} target="_blank" rel="noopener" class="btn-bsky" title="View the daily highlight post on Bluesky">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>
              Post ↗
            </a>
          )}
          <a href={shareUrl} target="_blank" rel="noopener" class="btn-bsky" title="Share on Bluesky">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>
            Share
          </a>
          <a href={withRef(d.url)} target="_blank" rel="noopener" class="btn-gh">
            View on GitHub ↗
          </a>
        </div>
      </div>
    </article>

    <!-- ── Insights: momentum, why it's here, how to help ── -->
    <div class="insights-grid">
      {series && (
        <section class="insight-panel momentum" aria-labelledby="momentum-label">
          <p class="panel-label" id="momentum-label">// momentum</p>
          <div class="insight-body">
            <WeeklySpark series={series} />
            {sinceFeatured && sinceFeatured.delta > 0 && (
              <p class="since-featured">
                <strong>+{sinceFeatured.delta}★</strong> since featured on SilentStars
                <span class="dim">({featuredDate})</span>
              </p>
            )}
            {featuredIn.length > 0 && (
              <>
                <p class="sub-label">featured in</p>
                <ul class="featured-list">
                  {featuredIn.map(f => (
                    <li>
                      <a href={`${base}weekly/${f.week}/`}>Edition #{f.issue}</a>
                      <span class={`fi-section fi-${f.section}`}>{sectionLabels[f.section]}</span>
                      <span class="fi-reason">{f.reason}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </section>
      )}

      <section class="insight-panel" aria-labelledby={why.length > 0 ? 'why-label' : 'help-label'}>
        {why.length > 0 && (
          <>
            {/* Text in an expression: an apostrophe would open a JS string, so it goes through a literal. */}
            <p class="panel-label" id="why-label">{"// why it's here"}</p>
            <ul class="why-list insight-body">
              {why.map(line => <li>{line}</li>)}
            </ul>
          </>
        )}
        <p class="panel-label" id="help-label">// how to help</p>
        <div class="help-links insight-body">
          {help.map(l => (
            <a href={withRef(l.href)} target="_blank" rel="noopener" class="help-link">{l.label} ↗</a>
          ))}
        </div>
      </section>
    </div>

    <!-- ── Expanded stats + content ── -->
    <div class="detail-grid">

      <!-- stats panel -->
      <aside class="stats-panel">
        <p class="panel-label">// stats</p>

        <div class="stat-row">
          <span class="stat-key">last commit</span>
          <span class="stat-val">{relDate(d.lastCommitAt)}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">latest release</span>
          <span class="stat-val">{d.lastReleaseAt ? relDate(d.lastReleaseAt) : '—'}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">releases (90d)</span>
          <span class="stat-val">{d.recentReleases ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">open issues</span>
          <span class="stat-val">{d.openIssues}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">closed issues</span>
          <span class="stat-val">{d.closedIssues ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">forks</span>
          <span class="stat-val">{d.forks}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">watchers</span>
          <span class="stat-val">{d.watchers ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">contributors</span>
          <span class="stat-val">{d.contributors ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">created</span>
          <span class="stat-val">{fullDateTime(d.createdAt)}</span>
        </div>
        {d.discussionCount != null && (
          <div class="stat-row">
            <span class="stat-key">discussions</span>
            <span class="stat-val">{d.discussionCount}</span>
          </div>
        )}

        {d.fundingLinks && d.fundingLinks.length > 0 && (
          <>
            <div class="stat-row">
              <span class="stat-key">funding</span>
            </div>
            {d.fundingLinks.map(f => {
              const sep      = f.indexOf(':');
              const platform = sep > -1 ? f.slice(0, sep).toLowerCase().replace(/_/g, ' ') : 'sponsor';
              const url      = sep > -1 ? f.slice(sep + 1) : f;
              return (
                <div class="stat-row">
                  <span class="stat-key">{platform}</span>
                  <a href={url} target="_blank" rel="noopener" class="funding-link">↗</a>
                </div>
              );
            })}
          </>
        )}

        {d.status === 'revived' && d.revivedAfterMonths && (
          <div class="revived-note">
            ↻ inactive {d.revivedAfterMonths}mo → back {d.revivedDaysAgo}d ago
          </div>
        )}
      </aside>

      <!-- prose content -->
      <div class="prose-panel">
        <p class="panel-label">// readme</p>
        <article class="prose">
          <Content />
        </article>
        <a href={withRef(`${d.url}#readme`)} target="_blank" rel="noopener" class="readme-more">
          Read the full README on GitHub ↗
        </a>
      </div>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-label">
        <h2 class="related-label" id="related-label">// related projects</h2>
        <p class="related-sub">Projects sharing topics with {d.name}</p>
        <div class="related-grid">
          {related.map(r => <ProjectCard {...r} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .breadcrumb {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }
  .breadcrumb a { color: var(--muted); }
  .breadcrumb a:hover { color: var(--ink); text-decoration: none; }

  .hero-thumb {
    margin: -20px -20px 20px;
    overflow: hidden;
    border-radius: 10px 10px 0 0;
    border-bottom: 2px solid var(--ink);
    aspect-ratio: 2 / 1;
  }
  .hero-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Hero card ── */
  .hero-card {
    display: flex;
    flex-direction: column;
    padding: 18px;
    border-radius: 8px;
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--shadow);
    gap: 0;
    margin-bottom: 1.5rem;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }
  .card-badges { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }

  .cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px 3px 4px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    color: #17150f;
    transform: rotate(-2deg);
  }
  .lang-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px 3px 4px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    background: #fff;
    color: #17150f;
  }
  .lang-chip--secondary {}

  .card-score { display: flex; align-items: baseline; gap: 2px; font-family: var(--f-display); }
  .score-arrow { color: var(--accent); font-size: 14px; font-weight: 800; }
  .score-num   { color: var(--accent); font-size: 28px; font-weight: 800; letter-spacing: -0.03em; }


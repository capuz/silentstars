---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(p => ({ params: { slug: p.slug }, props: { project: p } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await project.render();
const d = project.data;

// ── Category badge (same as ProjectCard) ──────────────────────
const catMap: Record<string, { label: string; bg: string; path: string }> = {
  newborn:  { label: 'Newborn',  bg: '#bdebd0',
    path: '<path d="M12 21v-8"/><path d="M12 13C12 9 9 6.5 5 6.5 5 10.5 8 13 12 13z"/><path d="M12 13.5c0-3.5 2.6-6 6-6 0 3.5-2.6 6-6 6z"/>' },
  thriving: { label: 'Thriving', bg: '#ffe08a',
    path: '<path d="M3 17l6-6 4 4 8-8"/><path d="M17 7h4v4"/>' },
  quiet:    { label: 'Quiet',    bg: '#e6e0d2',
    path: '<path d="M21 12.8A8 8 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8z"/>' },
  at_risk:  { label: 'At Risk',  bg: '#ffd5cc',
    path: '<path d="M12 9v4m0 3h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>' },
  revived:  { label: 'Revived',  bg: '#e8d5f5',
    path: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>' },
  watched:  { label: 'Watched',  bg: '#d5eeff',
    path: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>' },
  archived: { label: 'Archived', bg: '#e2e0da',
    path: '<rect x="2" y="4" width="20" height="5" rx="2"/><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"/><path d="M10 13h4"/>' },
};
const cat = catMap[d.status] ?? catMap.quiet!;
const catIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#17150f" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${cat.path}</svg>`;
const catIconSrc = `data:image/svg+xml,${encodeURIComponent(catIconSvg)}`;

// ── Language chip ──────────────────────────────────────────────
const langCodes: Record<string, string> = {
  TypeScript: 'TS', JavaScript: 'JS', Python: 'PY', Go: 'GO', Rust: 'RS',
  Ruby: 'RB', Java: 'JV', Kotlin: 'KT', Swift: 'SW', 'C++': 'C+', 'C#': 'C#',
  PHP: 'PH', Dart: 'DA', Scala: 'SC', Haskell: 'HS', Lua: 'LU', Elixir: 'EX',
  Zig: 'ZG', Shell: 'SH', HTML: 'HT', CSS: 'CS', Vue: 'VU', Svelte: 'SV',
  Clojure: 'CL', Julia: 'JL', C: 'C ',
};
const deviconMap: Record<string, string> = {
  TypeScript: 'typescript', JavaScript: 'javascript', Python: 'python', Go: 'go',
  Rust: 'rust', Ruby: 'ruby', Java: 'java', Kotlin: 'kotlin', Swift: 'swift',
  'C++': 'cplusplus', 'C#': 'csharp', PHP: 'php', Dart: 'dart', Scala: 'scala',
  Haskell: 'haskell', Lua: 'lua', Elixir: 'elixir', Zig: 'zig', Shell: 'bash',
  HTML: 'html5', CSS: 'css3', Vue: 'vuejs', Svelte: 'svelte', Clojure: 'clojure',
  Julia: 'julia', C: 'c',
};
const langSlug = d.language ? deviconMap[d.language] : undefined;
const langIcon  = langSlug ? `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${langSlug}/${langSlug}-original.svg` : null;
const langCode  = d.language ? (langCodes[d.language] ?? d.language.slice(0, 2).toUpperCase()) : null;
const lang1Pct  = d.languagePcts?.[0] ?? null;

const secondaryLang = d.languages?.[1] && d.languages[1] !== d.language ? d.languages[1] : null;
const lang2Slug = secondaryLang ? deviconMap[secondaryLang] : undefined;
const lang2Icon = lang2Slug ? `https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${lang2Slug}/${lang2Slug}-original.svg` : null;
const lang2Code = secondaryLang ? (langCodes[secondaryLang] ?? secondaryLang.slice(0, 2).toUpperCase()) : null;
const lang2Pct  = d.languagePcts?.[1] ?? null;

// ── Health ─────────────────────────────────────────────────────
function healthMeta(h: number) {
  if (h >= 80) return { color: '#1f9d55', label: 'Healthy' };
  if (h >= 60) return { color: '#c98a1e', label: 'Stable' };
  if (h >= 40) return { color: '#d4691e', label: 'Quiet' };
  return         { color: '#d8392b', label: 'At Risk' };
}
const { color: hColor, label: hLabel } = healthMeta(d.healthScore);

// ── Meta helpers ───────────────────────────────────────────────
function relDate(iso: string) {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  if (days === 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 30)  return `${days}d ago`;
  const mo = Math.floor(days / 30);
  if (mo < 12)    return `${mo}mo ago`;
  return `${Math.floor(mo / 12)}y ago`;
}
function mmyyyy(iso: string) {
  const d = new Date(iso);
  return `${String(d.getMonth()+1).padStart(2,'0')}-${d.getFullYear()}`;
}

const daysSince = Math.floor((Date.now() - new Date(d.lastCommitAt).getTime()) / 86_400_000);
const age       = daysSince === 0 ? 'today' : daysSince === 1 ? '1d ago' : `${daysSince}d ago`;
const author    = d.maintainers[0] ?? d.repo.split('/')[0];
const authorUrl = `https://github.com/${author}`;

const tagLabels: Record<string, string> = {
  solo_builder:       'solo builder',
  needs_contributors: 'help wanted',
  hidden_gem:         'hidden gem',
  legacy_hero:        'legacy hero',
  community_watch:    'community watch',
  funded:             'funded',
  release_machine:    'release machine',
  under_pressure:     'under pressure',
  community_hub:      'community hub',
  fork_magnet:        'fork magnet',
};

const base    = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}og/${project.slug}.png`, Astro.site).href;
const customImage = d.openGraphImageUrl?.includes('repository-images.githubusercontent.com')
  ? d.openGraphImageUrl : null;
const pageUrl = new URL(`${base}projects/${project.slug}/`, Astro.site).href;
const bskyText = encodeURIComponent(`★ ${d.name} — ${d.description}\n\n${pageUrl}`);
const bskyUrl  = `https://bsky.app/intent/compose?text=${bskyText}`;
---
<Base title={d.name} description={d.description} ogImage={ogImage}>
  <div class="container section">

    <nav class="breadcrumb">
      <a href={`${base}projects/`}>← directory</a>
    </nav>

    <!-- ── Hero card (same visual language as ProjectCard) ── -->
    <article class="hero-card">

      {customImage && (
        <div class="hero-thumb">
          <img src={customImage} alt={d.name} loading="eager" decoding="async" />
        </div>
      )}

      <!-- top row -->
      <div class="card-top">
        <div class="card-badges">
          <span class="cat-badge" style={`background:${cat.bg};`}>
            <img src={catIconSrc} alt={cat.label} width="16" height="16" />
            {cat.label}
          </span>
          {d.language && langCode && (
            <span class="lang-chip" title={lang1Pct ? `${d.language} ${lang1Pct}%` : d.language}>
              {langIcon && (
                <img src={langIcon} alt={d.language} width="16" height="16"
                  onerror="this.style.display='none'" />
              )}
              {langCode}
            </span>
          )}
          {secondaryLang && lang2Code && (
            <span class="lang-chip lang-chip--secondary"
                  title={lang2Pct ? `${secondaryLang} ${lang2Pct}%` : secondaryLang}>
              {lang2Icon && (
                <img src={lang2Icon} alt={secondaryLang} width="14" height="14"
                  onerror="this.style.display='none'" />
              )}
              {lang2Code}
            </span>
          )}
        </div>
        <div class="card-score" title="Undervalued score">
          <span class="score-arrow">↑</span>
          <span class="score-num">{d.undervaluedScore}</span>
        </div>
      </div>

      <!-- name + repo -->
      <a href={d.url} target="_blank" rel="noopener noreferrer" class="card-name">{d.name}</a>
      <span class="card-slug">{d.repo}</span>

      <!-- description -->
      <p class="card-desc">{d.description}</p>

      {d.homepage && (
        <a href={d.homepage} target="_blank" rel="noopener" class="card-homepage">
          {d.homepage} ↗
        </a>
      )}

      <!-- health bar -->
      <div class="health-wrap">
        <div class="health-header">
          <span class="health-label-text">HEALTH</span>
          <span class="health-value" style={`color:${hColor};`}>{d.healthScore} / {hLabel}</span>
        </div>
        <div class="health-track">
          <div class="health-fill" style={`width:${d.healthScore}%;background:${hColor};`}></div>
        </div>
      </div>

      <!-- tags -->
      {(d.tags.length > 0 || (d.topics && d.topics.length > 0)) && (
        <div class="card-tags">
          {d.tags.map(t => <span class="tag">// {tagLabels[t] ?? t}</span>)}
          {d.topics?.map(t => <span class="tag tag--topic">{t}</span>)}
        </div>
      )}

      <!-- footer -->
      <div class="card-footer">
        <span class="footer-meta">
          {d.createdAt && (
            <>
              <span class="meta-since">{mmyyyy(d.createdAt)}</span>
              <span class="meta-dot">·</span>
            </>
          )}
          <span class="meta-age">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5l3 2"/></svg>
            {age}
          </span>
          <span class="meta-dot">·</span>
          <a href={authorUrl} target="_blank" rel="noopener" class="meta-author">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.6"/><path d="M5.5 20c0-3.4 2.9-5.8 6.5-5.8s6.5 2.4 6.5 5.8"/></svg>
            {author}
          </a>
        </span>
        <div class="footer-right">
          <a href={d.url} target="_blank" rel="noopener noreferrer" class="footer-stars">
            <span>★</span>{d.stars}
          </a>
          <a href={bskyUrl} target="_blank" rel="noopener noreferrer" class="btn-bsky" title="Share on Bluesky">
            <svg width="13" height="13" viewBox="0 0 568 501" fill="currentColor" aria-hidden="true">
              <path d="M123.121 33.664C188.898 82.147 259.758 180.6 284 234.217c24.242-53.617 95.102-152.07 160.879-200.553C491.44-.584 568-13.998 568 66.914c0 15.773-9.019 132.555-14.301 151.42-18.372 65.631-85.347 82.35-144.986 72.218 104.16 17.695 130.667 76.28 73.358 134.862-108.836 111.703-156.394-28.032-168.441-63.86-2.26-6.643-3.313-9.738-3.33-7.108-.016 2.63-1.069 5.725-3.329 12.368-12.047 35.828-59.605 175.563-168.441 63.86C79.001 371.802 105.508 313.217 209.668 295.52c-59.64 10.132-126.615-6.587-144.987-72.218C59.38 204.437 50.36 87.655 50.36 71.882c0-80.912 76.56-67.498 72.761-38.218z"/>
            </svg>
            Share
          </a>
          <a href={d.url} target="_blank" rel="noopener noreferrer" class="btn-gh">
            View on GitHub ↗
          </a>
        </div>
      </div>
    </article>

    <!-- ── Expanded stats + content ── -->
    <div class="detail-grid">

      <!-- stats panel -->
      <aside class="stats-panel">
        <p class="panel-label">// stats</p>

        <div class="stat-row">
          <span class="stat-key">last commit</span>
          <span class="stat-val">{relDate(d.lastCommitAt)}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">latest release</span>
          <span class="stat-val">{d.lastReleaseAt ? relDate(d.lastReleaseAt) : '—'}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">releases (90d)</span>
          <span class="stat-val">{d.recentReleases ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">open issues</span>
          <span class="stat-val">{d.openIssues}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">closed issues</span>
          <span class="stat-val">{d.closedIssues ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">forks</span>
          <span class="stat-val">{d.forks}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">watchers</span>
          <span class="stat-val">{d.watchers ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">contributors</span>
          <span class="stat-val">{d.contributors ?? 0}</span>
        </div>
        <div class="stat-row">
          <span class="stat-key">created</span>
          <span class="stat-val">{mmyyyy(d.createdAt)}</span>
        </div>
        {d.discussionCount != null && (
          <div class="stat-row">
            <span class="stat-key">discussions</span>
            <span class="stat-val">{d.discussionCount}</span>
          </div>
        )}

        {d.fundingLinks && d.fundingLinks.length > 0 && (
          <div class="funding-block">
            <p class="panel-label">// funding</p>
            {d.fundingLinks.map(f => (
              <a href={f.url} target="_blank" rel="noopener" class="funding-link">
                {f.platform.toLowerCase().replace('_', ' ')} ↗
              </a>
            ))}
          </div>
        )}

        {d.status === 'revived' && d.revivedAfterMonths && (
          <div class="revived-note">
            ↻ inactive {d.revivedAfterMonths}mo → back {d.revivedDaysAgo}d ago
          </div>
        )}
      </aside>

      <!-- prose content -->
      <div class="prose-panel">
        <p class="panel-label">// readme</p>
        <article class="prose">
          <Content />
        </article>
      </div>
    </div>

  </div>
</Base>

<style>
  .breadcrumb {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }
  .breadcrumb a { color: var(--muted); }
  .breadcrumb a:hover { color: var(--ink); text-decoration: none; }

  .hero-thumb {
    margin: -20px -20px 20px;
    overflow: hidden;
    border-radius: 10px 10px 0 0;
    border-bottom: 2px solid var(--ink);
    aspect-ratio: 2 / 1;
  }
  .hero-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Hero card ── */
  .hero-card {
    display: flex;
    flex-direction: column;
    padding: 18px;
    border-radius: 8px;
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--shadow);
    gap: 0;
    margin-bottom: 1.5rem;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }
  .card-badges { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }

  .cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px 3px 4px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    color: #17150f;
    transform: rotate(-2deg);
  }
  .lang-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px 3px 4px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    background: #fff;
    color: #17150f;
  }
  .lang-chip--secondary {
    font-size: 10px;
    padding: 2px 8px 2px 3px;
    opacity: 0.72;
    border-style: dashed;
  }

  .card-score { display: flex; align-items: baseline; gap: 2px; font-family: var(--f-display); }
  .score-arrow { color: var(--accent); font-size: 14px; font-weight: 800; }
  .score-num   { color: var(--accent); font-size: 28px; font-weight: 800; letter-spacing: -0.03em; }

  .card-name {
    font-family: var(--f-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin-bottom: 3px;
    transition: color .12s;
  }
  .card-name:hover { color: var(--accent); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .card-slug {
    font-family: var(--f-mono);
    font-size: 11.5px;
    color: var(--muted);
    margin-bottom: 12px;
    display: block;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 10px;
    font-weight: 500;
    max-width: 72ch;
  }

  .card-homepage {
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 14px;
    display: block;
  }
  .card-homepage:hover { color: var(--accent); text-decoration: underline; }

  .health-wrap { margin-bottom: 14px; }
  .health-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .health-label-text { color: var(--muted); letter-spacing: .04em; }
  .health-track {
    height: 8px;
    border-radius: 999px;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    overflow: hidden;
  }
  .health-fill { height: 100%; }

  .card-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 16px; }
  .tag {
    font-family: var(--f-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--ink);
    padding: 2px 7px;
    border-radius: 5px;
    border: 1.5px solid var(--faint);
  }
  .tag--topic {
    opacity: 0.65;
    font-weight: 500;
    border-style: dashed;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 13px;
    border-top: 1.5px solid var(--faint);
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    flex-wrap: wrap;
  }
  .footer-meta { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); flex-wrap: wrap; }
  .meta-age    { display: inline-flex; align-items: center; gap: 4px; }
  .meta-dot    { opacity: .45; }
  .meta-author { display: inline-flex; align-items: center; gap: 4px; color: inherit; }
  .meta-author:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  .footer-right { display: flex; align-items: center; gap: 8px; }
  .footer-stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    transition: background .12s, color .12s;
  }
  .footer-stars:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

  .btn-bsky {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 11px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    background: transparent;
    letter-spacing: 0.02em;
    transition: background .12s, color .12s;
  }
  .btn-bsky:hover { background: #0085ff; border-color: #0085ff; color: #fff; text-decoration: none; }

  .btn-gh {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    letter-spacing: 0.02em;
    transition: opacity .12s;
  }
  .btn-gh:hover { opacity: .8; text-decoration: none; }

  /* ── Detail grid ── */
  .detail-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 680px) {
    .detail-grid { grid-template-columns: 1fr; }
  }

  .stats-panel,
  .prose-panel {
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--card);
    box-shadow: 2px 2px 0 var(--shadow);
    overflow: hidden;
  }

  .panel-label {
    font-family: var(--f-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding: 8px 12px;
    border-bottom: 1.5px solid var(--faint);
    margin: 0;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-bottom: 1px solid var(--faint);
  }
  .stat-row:last-child { border-bottom: none; }
  .stat-key {
    font-family: var(--f-mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
  }
  .stat-val {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink);
  }

  .revived-note {
    font-family: var(--f-mono);
    font-size: 0.6rem;
    color: var(--revived);
    border-left: 2px solid var(--revived);
    padding: 6px 10px;
    background: rgba(124, 58, 237, 0.06);
  }

  .funding-block { margin-top: 1.25rem; }
  .funding-link {
    display: block;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--accent);

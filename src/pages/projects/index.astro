---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import promotedRaw from '../../../data/promoted.json';
import { isListable } from '../../../scripts/discovery-filter.ts';

type PromotedEntry = { repo: string; until: string | null };
const promotedEntries = promotedRaw as PromotedEntry[];
const promotedRepos = new Set(promotedEntries.map(e => e.repo.toLowerCase()));

const all = await getCollection('projects');

const projects = all
  .filter(p => {
    if (p.data.status === 'archived' || !isListable(p.data.repo, p.data.stars)) return false;
    const d = p.data.description.trim();
    return d !== '' && d.toLowerCase() !== p.data.name.toLowerCase();
  })
  .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore);

const regular  = projects.filter(p => !promotedRepos.has(p.data.repo.toLowerCase()));
const promoted = projects.filter(p =>  promotedRepos.has(p.data.repo.toLowerCase()));

// Initial paint only ships the first batch visible; the rest ships in the
// same HTML (no-JS still gets a working, capped directory) but starts
// display:none so first paint isn't 283 cards / ~39,000px tall. The script
// below reveals more as the sentinel scrolls into view.
const BATCH_SIZE = 30;

const statuses = ['thriving', 'watched', 'quiet', 'at_risk', 'newborn', 'revived'] as const;
const tags = ['solo_builder', 'needs_contributors', 'hidden_gem', 'legacy_hero', 'community_watch'] as const;

const statusLabels: Record<string, string> = {
  thriving: 'Thriving',
  watched:  'Watched',
  quiet:    'Quiet',
  at_risk:  'At Risk',
  newborn:  'Newborn',
  revived:  'Revived',
};
const tagLabels: Record<string, string> = {
  solo_builder:       '// solo',
  needs_contributors: '// help wanted',
  hidden_gem:         '// hidden gem',
  legacy_hero:        '// legacy',
  community_watch:    '// community watch',
};
---
<Base title="Directory" description="All open source projects tracked by SilentStars, sorted by Undervalued Score.">
  <div class="container section">
    <div class="dir-header">
      <h1>// Directory</h1>
      <p class="subtitle">
        {projects.length} projects · sorted by Undervalued Score
        <span class="hint">( signal ÷ log₁₀(stars + watchers) )</span>
      </p>
    </div>


    <div class="search-wrap">
      <input
        id="search"
        type="search"
        placeholder="// search projects…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="filters" id="filters">
      <div class="filter-group">
        <span class="filter-label">status</span>
        {statuses.map(s => (
          <button type="button" class="filter-btn" data-filter-status={s} aria-pressed="false">{statusLabels[s]}</button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">tags</span>
        {tags.map(t => (
          <button type="button" class="filter-btn" data-filter-tag={t} aria-pressed="false">{tagLabels[t]}</button>
        ))}
      </div>
      <button type="button" class="filter-reset" id="filter-reset">reset</button>
    </div>

    <div class="grid" id="project-grid" data-batch-size={BATCH_SIZE}>
      {regular.map((p, i) => (
        <div
          class={i < BATCH_SIZE ? 'grid-item' : 'grid-item is-paginated'}
          data-status={p.data.status}
          data-tags={p.data.tags.join(',')}
          data-search={`${p.data.name} ${p.data.repo} ${p.data.description ?? ''} ${p.data.language ?? ''}`.toLowerCase()}
        >
          <ProjectCard slug={p.id} {...p.data} />
        </div>
      ))}
    </div>
    <div id="scroll-sentinel" aria-hidden="true"></div>

    <div class="empty-state" id="empty-state" style="display:none">
      <p>No projects match these filters.</p>
      <button type="button" class="filter-reset" id="empty-reset">Clear filters</button>
    </div>

    {promoted.length > 0 && (
      <div class="promoted-block" id="promoted-block">
        <p class="promoted-label">// submitted by maintainers</p>
        <div class="grid">
          {promoted.map(p => (
            <div
              class="grid-item"
              data-promoted="true"
              data-status={p.data.status}
              data-tags={p.data.tags.join(',')}
              data-search={`${p.data.name} ${p.data.repo} ${p.data.description ?? ''} ${p.data.language ?? ''}`.toLowerCase()}
            >
              <ProjectCard slug={p.id} {...p.data} promoted={true} />
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</Base>

<script>
  import { parseFilters, serializeFilters } from '../../lib/project-filters.ts';

  const grid         = document.getElementById('project-grid')!;
  const emptyState   = document.getElementById('empty-state')!;
  const resetBtn     = document.getElementById('filter-reset')!;
  const searchEl     = document.getElementById('search') as HTMLInputElement;
  const promotedBlock = document.getElementById('promoted-block') as HTMLElement | null;
  const sentinel     = document.getElementById('scroll-sentinel');

  const items = Array.from(document.querySelectorAll<HTMLElement>('.grid-item'));
  const BATCH_SIZE = Number(grid.dataset.batchSize) || 30;

  let activeStatuses = new Set<string>();
  let activeTags     = new Set<string>();
  let searchQuery    = '';
  let revealedCount  = BATCH_SIZE;
  let hasMoreToReveal = false;

  const statusBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-status]'));
  const tagBtns    = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]'));

  function syncButtons() {
    statusBtns.forEach(b => { const on = activeStatuses.has(b.dataset.filterStatus!); b.classList.toggle('active', on); b.setAttribute('aria-pressed', String(on)); });
    tagBtns.forEach(b => { const on = activeTags.has(b.dataset.filterTag!); b.classList.toggle('active', on); b.setAttribute('aria-pressed', String(on)); });
  }

  // Keep the filters in the URL (replaceState: no history entry per click) so a
  // filtered view can be shared and comes back with the Back button.
  function syncUrl() {
    const qs = serializeFilters({ statuses: [...activeStatuses], tags: [...activeTags], q: searchQuery });
    const url = location.pathname + (qs ? `?${qs}` : '') + location.hash;
    if (url !== location.pathname + location.search + location.hash) history.replaceState(history.state, '', url);
  }

  function applyFilters() {
    const q = searchQuery.length >= 3 ? searchQuery : '';
    const filtering = activeStatuses.size > 0 || activeTags.size > 0 || q !== '';
    let visible = 0;
    let regularMatchIndex = 0;
    items.forEach(item => {
      const status     = item.dataset.status ?? '';
      const tags       = (item.dataset.tags ?? '').split(',').filter(Boolean);
      const haystack   = item.dataset.search ?? '';
      const isPromoted = item.dataset.promoted === 'true';
      const matchSearch = !q || haystack.includes(q);
      const matchStatus = activeStatuses.size === 0 || activeStatuses.has(status);
      const matchTag    = activeTags.size === 0 || tags.some(t => activeTags.has(t));
      const matches = matchSearch && matchStatus && matchTag;
      let show = false;
      if (matches) {
        if (isPromoted || filtering) {
          show = true;
        } else {
          regularMatchIndex++;
          show = regularMatchIndex <= revealedCount;
        }
      }
      // 'block' (not '') so the inline style actually beats the
      // .is-paginated { display:none } class once an item is revealed —
      // clearing the inline style falls back to the class, not the default.
      item.style.display = show ? 'block' : 'none';
      if (show) visible++;
    });
    emptyState.style.display = visible === 0 ? '' : 'none';
    if (promotedBlock) {
      const anyPromotedVisible = Array.from(
        promotedBlock.querySelectorAll<HTMLElement>('.grid-item')
      ).some(el => el.style.display !== 'none');
      promotedBlock.style.display = anyPromotedVisible ? '' : 'none';
    }
    hasMoreToReveal = !filtering && regularMatchIndex > revealedCount;
  }

  // Infinite scroll: reveal the next batch (already in the DOM, just
  // display:none) as the sentinel below the grid comes into view. Disabled
  // while filtering/searching — a filtered match set is small enough to
  // show in full, so pagination would just hide results the user asked for.
  if (sentinel) {
    const io = new IntersectionObserver(entries => {
      if (!entries[0].isIntersecting || !hasMoreToReveal) return;
      revealedCount += BATCH_SIZE;
      applyFilters();
    }, { rootMargin: '800px 0px' });
    io.observe(sentinel);
  }

  searchEl.addEventListener('input', () => {
    searchQuery = searchEl.value.trim().toLowerCase();
    applyFilters();
    syncUrl();
  });

  statusBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const s = btn.dataset.filterStatus!;
      activeStatuses.has(s) ? activeStatuses.delete(s) : activeStatuses.add(s);
      syncButtons();
      applyFilters();
      syncUrl();
    });
  });

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.filterTag!;
      activeTags.has(t) ? activeTags.delete(t) : activeTags.add(t);
      syncButtons();
      applyFilters();
      syncUrl();
    });
  });

  const reset = () => {
    activeStatuses.clear();
    activeTags.clear();
    searchQuery = '';
    searchEl.value = '';
    syncButtons();
    applyFilters();
    syncUrl();
  };
  resetBtn.addEventListener('click', reset);
  document.getElementById('empty-reset')?.addEventListener('click', () => { reset(); searchEl.focus(); });

  // Restore filters from the URL (shared link, reload, Back).
  const initial = parseFilters(new URLSearchParams(location.search), {
    statuses: statusBtns.map(b => b.dataset.filterStatus!),
    tags: tagBtns.map(b => b.dataset.filterTag!),
  });
  activeStatuses = new Set(initial.statuses);
  activeTags = new Set(initial.tags);
  searchQuery = initial.q;
  searchEl.value = initial.q;
  syncButtons();

  // Server already rendered the correct display:none split for BATCH_SIZE,
  // but hasMoreToReveal (read by the sentinel observer above) is only
  // computed inside applyFilters — run it once so scrolling works before
  // any filter/search interaction happens.
  applyFilters();
</script>

<style>
  .search-wrap {
    margin-bottom: 1rem;
  }
  #search {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    background: var(--bg-card);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    padding: 0.6em 1em;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box;
  }
  #search::placeholder { color: var(--text-dim); font-weight: 400; }
  #search:focus { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 20%, transparent); }

  .dir-header { margin-bottom: 2rem; }
  .dir-header h1 { font-size: 1.75rem; margin-bottom: 0.4rem; letter-spacing: -0.02em; }
  .subtitle { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); }
  .hint { color: var(--text-dim); }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 2rem;
    padding: 0.875rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .filter-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: lowercase;
    color: var(--text-dim);
    margin-right: 0.2rem;
    letter-spacing: 0.04em;
  }
  .filter-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0.2em 0.6em;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .filter-btn:hover { border-color: var(--text-muted); color: var(--text-muted); }
  .filter-btn.active { border-color: var(--revived); color: var(--revived); }

  .filter-reset {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    cursor: pointer;
    letter-spacing: 0.04em;
  }
  .filter-reset:hover { color: var(--text); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.875rem;
  }
  .is-paginated {
    display: none;
  }
  #scroll-sentinel {
    height: 1px;
  }
  .empty-state {
    text-align: center;
    color: var(--text-dim);
    padding: 3rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .empty-state p { margin-bottom: .75rem; }
  /* The in-grid reset is the visible way out of an empty result, so it reads as a button. */
  .empty-state .filter-reset { border: 1.5px solid var(--ink); border-radius: 999px; padding: 4px 14px; color: var(--ink); }

  /* Skip style/layout/paint for cards outside the viewport. Showing ~300 cards
     at once (status filter, reset) cost up to 1 s of presentation delay at 4x CPU.
     The first 6 cards are above the fold on desktop, so they render normally.
     contain-intrinsic-size keeps the scrollbar stable; `auto` remembers real heights.
     The promoted cards sit below the whole grid, so all of them get it too.
     Baseline newly available (2025-09); other browsers ignore it. */
  #project-grid > .grid-item:nth-child(n + 7),
  .promoted-block .grid-item {
    content-visibility: auto;
    contain-intrinsic-size: auto none auto 340px;
  }

  .promoted-block {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .promoted-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
</style>

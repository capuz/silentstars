---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import promotedRaw from '../../../data/promoted.json';

type PromotedEntry = { repo: string; until: string | null };
const promotedEntries = promotedRaw as PromotedEntry[];
const promotedRepos = new Set(promotedEntries.map(e => e.repo.toLowerCase()));

const all = await getCollection('projects');

const projects = all
  .filter(p => p.data.status !== 'archived')
  .sort((a, b) => b.data.attentionGap - a.data.attentionGap);

const regular  = projects.filter(p => !promotedRepos.has(p.data.repo.toLowerCase()));
const promoted = projects.filter(p =>  promotedRepos.has(p.data.repo.toLowerCase()));

const statuses = ['thriving', 'quiet', 'at_risk', 'newborn', 'revived'] as const;
const tags = ['solo_builder', 'needs_contributors', 'hidden_gem', 'legacy_hero'] as const;

const statusLabels: Record<string, string> = {
  thriving: 'Thriving',
  quiet:    'Quiet',
  at_risk:  'At Risk',
  newborn:  'Newborn',
  revived:  'Revived',
};
const tagLabels: Record<string, string> = {
  solo_builder:       '// solo',
  needs_contributors: '// help wanted',
  hidden_gem:         '// hidden gem',
  legacy_hero:        '// legacy',
};
---
<Base title="Directory" description="All open source projects tracked by SilentStars, sorted by Attention Gap.">
  <div class="container section">
    <div class="dir-header">
      <h1>// Directory</h1>
      <p class="subtitle">
        {projects.length} projects · sorted by Attention Gap
        <span class="hint">( vitality ÷ log₁₀(stars) )</span>
      </p>
    </div>


    <div class="filters" id="filters">
      <div class="filter-group">
        <span class="filter-label">status</span>
        {statuses.map(s => (
          <button class="filter-btn" data-filter-status={s}>{statusLabels[s]}</button>
        ))}
      </div>
      <div class="filter-group">
        <span class="filter-label">tags</span>
        {tags.map(t => (
          <button class="filter-btn" data-filter-tag={t}>{tagLabels[t]}</button>
        ))}
      </div>
      <button class="filter-reset" id="filter-reset">reset</button>
    </div>

    <div class="grid" id="project-grid">
      {regular.map(p => (
        <div
          class="grid-item"
          data-status={p.data.status}
          data-tags={p.data.tags.join(',')}
        >
          <ProjectCard slug={p.slug} {...p.data} />
        </div>
      ))}
    </div>

    <p class="empty-state" id="empty-state" style="display:none">
      No projects match the selected filters.
    </p>

    {promoted.length > 0 && (
      <div class="promoted-block">
        <p class="promoted-label">// promoted</p>
        <div class="grid">
          {promoted.map(p => (
            <ProjectCard slug={p.slug} {...p.data} promoted={true} />
          ))}
        </div>
      </div>
    )}
  </div>
</Base>

<script>
  const grid = document.getElementById('project-grid')!;
  const emptyState = document.getElementById('empty-state')!;
  const resetBtn = document.getElementById('filter-reset')!;

  let activeStatuses = new Set<string>();
  let activeTags = new Set<string>();

  function applyFilters() {
    const items = grid.querySelectorAll<HTMLElement>('.grid-item');
    let visible = 0;
    items.forEach(item => {
      const status = item.dataset.status ?? '';
      const tags = (item.dataset.tags ?? '').split(',').filter(Boolean);
      const show = (activeStatuses.size === 0 || activeStatuses.has(status)) &&
                   (activeTags.size === 0 || tags.some(t => activeTags.has(t)));
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyState.style.display = visible === 0 ? '' : 'none';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-filter-status]').forEach(btn => {
    btn.addEventListener('click', () => {
      const s = btn.dataset.filterStatus!;
      activeStatuses.has(s) ? activeStatuses.delete(s) : activeStatuses.add(s);
      btn.classList.toggle('active', activeStatuses.has(s));
      applyFilters();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]').forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.filterTag!;
      activeTags.has(t) ? activeTags.delete(t) : activeTags.add(t);
      btn.classList.toggle('active', activeTags.has(t));
      applyFilters();
    });
  });

  resetBtn.addEventListener('click', () => {
    activeStatuses.clear();
    activeTags.clear();
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    applyFilters();
  });
</script>

<style>
  .dir-header { margin-bottom: 2rem; }
  .dir-header h1 { font-size: 1.75rem; margin-bottom: 0.4rem; letter-spacing: -0.02em; }
  .subtitle { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); }
  .hint { color: var(--text-dim); }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 2rem;
    padding: 0.875rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .filter-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: lowercase;
    color: var(--text-dim);
    margin-right: 0.2rem;
    letter-spacing: 0.04em;
  }
  .filter-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 0.2em 0.6em;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .filter-btn:hover { border-color: var(--text-muted); color: var(--text-muted); }
  .filter-btn.active { border-color: var(--revived); color: var(--revived); }

  .filter-reset {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    cursor: pointer;
    letter-spacing: 0.04em;
  }
  .filter-reset:hover { color: var(--text); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.875rem;
  }
  .empty-state {
    text-align: center;
    color: var(--text-dim);
    padding: 3rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .promoted-block {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .promoted-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
</style>

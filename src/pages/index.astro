---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = await getCollection('projects');
const visible = all.filter(p => {
  if (p.data.status === 'archived') return false;
  const d = p.data.description.trim();
  return d !== '' && d.toLowerCase() !== p.data.name.toLowerCase();
});

// ── Deduplication ─────────────────────────────────────────────────────────────
// Each project appears in at most one section (highest-priority wins).
type Entry = typeof visible[number];
const shown = new Set<string>();

function take(pool: Entry[], n: number): Entry[] {
  const result: Entry[] = [];
  for (const p of pool) {
    if (result.length >= n) break;
    if (!shown.has(p.slug)) { shown.add(p.slug); result.push(p); }
  }
  return result;
}

// promoted projects (community submissions) float above regular ones
function promotedFirst(a: Entry, b: Entry): number {
  const aP = a.data.promoted ? 1 : 0;
  const bP = b.data.promoted ? 1 : 0;
  if (aP !== bP) return bP - aP;
  return b.data.undervaluedScore - a.data.undervaluedScore;
}

// ── Sections (priority order — first match wins for dedup) ────────────────────

// Today's daily-highlight pick, pinned first in Top picks. CI sets FEATURED_SLUG
// (computed by select-post.ts before the build); local builds fall back to the
// most recently posted project.
const featuredSlug = process.env.FEATURED_SLUG
  || [...visible]
       .filter(p => p.data.postedAt)
       .sort((a, b) => new Date(b.data.postedAt!).getTime() - new Date(a.data.postedAt!).getTime())[0]?.slug;
const featured = visible.find(p => p.slug === featuredSlug);

const topPicks = take(
  [...(featured ? [featured] : []), ...[...visible].sort(promotedFirst)],
  9
);

const shipping = take(
  visible
    .filter(p => p.data.tags.includes('release_machine'))
    .sort((a, b) => (b.data.recentReleases ?? 0) - (a.data.recentReleases ?? 0)),
  6
);

const helpWanted = take(
  visible
    .filter(p => p.data.tags.includes('needs_contributors'))
    .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore),
  14
);

const underPressure = take(
  visible
    .filter(p => p.data.tags.includes('under_pressure'))
    .sort((a, b) => (b.data.openIssues ?? 0) - (a.data.openIssues ?? 0)),
  9
);

const soloBuilders = take(
  visible
    .filter(p => p.data.tags.includes('solo_builder'))
    .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore),
  9
);

const legacyHeroes = take(
  visible
    .filter(p => p.data.tags.includes('legacy_hero'))
    .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore),
  9
);

const forkMagnets = take(
  visible
    .filter(p => p.data.tags.includes('fork_magnet'))
    .sort((a, b) =>
      (b.data.forks / Math.max(b.data.stars, 1)) -
      (a.data.forks / Math.max(a.data.stars, 1))
    ),
  9
);

const watchedProjs = take(
  visible
    .filter(p => p.data.status === 'watched' || p.data.tags.includes('community_watch'))
    .sort((a, b) =>
      (b.data.watchers / Math.max(b.data.stars, 1)) -
      (a.data.watchers / Math.max(a.data.stars, 1))
    ),
  9
);

const funded = take(
  visible
    .filter(p => p.data.tags.includes('funded'))
    .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore),
  9
);

const hiddenGems = take(
  visible
    .filter(p => p.data.tags.includes('hidden_gem'))
    .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore),
  9
);

const newborns = take(
  visible
    .filter(p => p.data.status === 'newborn')
    .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime()),
  9
);

const revived = take(
  visible
    .filter(p => p.data.status === 'revived')
    .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore),
  9
);

const base = import.meta.env.BASE_URL;

// ── Global stats ───────────────────────────────────────────────────────────────
const totalProjects = visible.length;
const totalActive   = visible.filter(p => ['thriving','newborn','revived','watched'].includes(p.data.status)).length;
const totalSolo     = visible.filter(p => p.data.tags.includes('solo_builder')).length;
const totalStars    = visible.reduce((sum, p) => sum + (p.data.stars ?? 0), 0);
const starsDisplay  = totalStars >= 1000 ? `${(totalStars / 1000).toFixed(1)}k` : String(totalStars);
---
<Base title="SilentStars">
  <section class="hero">
    <div class="container">
      <p class="hero-kicker">// open source is more than stars</p>
      <h1 class="hero-title">Not famous. Not abandoned. <span class="accent">Just building.</span></h1>
      <p class="hero-lede">
        SilentStars tracks <strong>{totalProjects}</strong> open source projects that are actively built but chronically undervalued.
        No hype. No trending algorithms. Just signal.
      </p>
      <div class="hero-actions">
        <a href={`${base}projects/`} class="btn btn-primary">Browse the directory →</a>
        <a href={`${base}submit/`} class="btn btn-ghost">Submit a project →</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">{totalProjects}</span>
          <span class="stat-label">projects tracked</span>
        </div>
        <div class="stat-sep">·</div>
        <div class="stat">
          <span class="stat-num">{totalActive}</span>
          <span class="stat-label">actively building</span>
        </div>
        <div class="stat-sep">·</div>
        <div class="stat">
          <span class="stat-num">{totalSolo}</span>
          <span class="stat-label">solo builders</span>
        </div>
        <div class="stat-sep">·</div>
        <div class="stat">
          <span class="stat-num">★ {starsDisplay}</span>
          <span class="stat-label">combined stars</span>
        </div>
      </div>
    </div>
  </section>

  {topPicks.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Top picks</h2>
        <p>Highest signal-to-reach ratio — building more than their audience knows.</p>
      </div>
      <div class="grid">
        {topPicks.map(p => <ProjectCard slug={p.slug} featured={p.slug === featured?.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  <div class="submit-nudge container">
    <span class="nudge-text">Know a project that belongs here?</span>
    <a href={`${base}submit/`} class="nudge-link">Submit it →</a>
  </div>

  {shipping.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Shipping</h2>
        <p>5+ releases in 90 days — these teams don't stop.</p>
      </div>
      <div class="grid">
        {shipping.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {helpWanted.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Help wanted</h2>
        <p>The maintainer labelled the door open. Time to walk in.</p>
      </div>
      <div class="grid">
        {helpWanted.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {underPressure.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Under pressure</h2>
        <p>Healthy project, overwhelmed solo team. Worth saving.</p>
      </div>
      <div class="grid">
        {underPressure.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {soloBuilders.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Solo builders</h2>
        <p>One person carrying it all. No team. No VC. Just commits.</p>
      </div>
      <div class="grid">
        {soloBuilders.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {legacyHeroes.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Legacy heroes</h2>
        <p>5+ years old and still committing. Resilience over hype.</p>
      </div>
      <div class="grid">
        {legacyHeroes.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {forkMagnets.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Fork magnets</h2>
        <p>More forks than stars — used as a building block, not just bookmarked.</p>
      </div>
      <div class="grid">
        {forkMagnets.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {watchedProjs.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Watched</h2>
        <p>Devs are tracking these before the public notices.</p>
      </div>
      <div class="grid">
        {watchedProjs.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {funded.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Funded</h2>
        <p>Financially supported. Committed to shipping long-term.</p>
      </div>
      <div class="grid">
        {funded.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {hiddenGems.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Hidden gems</h2>
        <p>Under 100 stars. Documented. Alive. Look closer.</p>
      </div>
      <div class="grid">
        {hiddenGems.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {newborns.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Newborn</h2>
        <p>Born in the last 2 months, committed in the last 2 weeks — fragile, alive, worth watching.</p>
      </div>
      <div class="grid">
        {newborns.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {revived.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Revived</h2>
        <p>Back from the dead. Someone cared enough to pick it up again.</p>
      </div>
      <div class="grid">
        {revived.map(p => <ProjectCard slug={p.slug} {...p.data} />)}
      </div>
      <div class="see-more"><a href={`${base}resurrections/`}>see more →</a></div>
    </section>
  )}

  <section id="subscribe" class="section container newsletter-section">
    <div class="newsletter-inner">
      <div class="newsletter-copy">
        <p class="newsletter-label"><span class="mono-prefix">//</span> stay in the loop</p>
        <p class="newsletter-desc">Weekly hidden gems — one digest, no noise.</p>
      </div>
      <form
        id="newsletter-form"
        class="newsletter-form"
        action="https://buttondown.com/api/emails/embed-subscribe/silentstars"
        method="post"
        target="popupwindow"
      >
        <input type="email" name="email" required placeholder="your@email.com" class="newsletter-input" />
        <input type="hidden" name="embed" value="1" />
        <button type="submit" class="newsletter-btn">Subscribe</button>
      </form>
      <p id="newsletter-msg" class="newsletter-msg" aria-live="polite"></p>
    </div>
  </section>

  <section class="section container cta-section">
    <p class="cta-text">→ see all {visible.length} projects in the directory</p>
    <div class="cta-actions">
      <a href={`${base}projects/`} class="btn btn-primary">Open directory</a>
      <a href={`${base}submit/`} class="btn btn-ghost">Submit a project →</a>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const msg  = document.getElementById('newsletter-msg') as HTMLParagraphElement;

  form?.addEventListener('submit', () => {
    window.open('https://buttondown.com/silentstars', 'popupwindow');
    msg.textContent = '✓ Complete the verification in the window that opened.';
  });
</script>

<style>
  /* Hero */
  .hero { width: 100%; padding: 26px 0 22px; border-bottom: 1px solid var(--border); }

  .hero-kicker {
    font-family: 'Space Mono', monospace;
    font-size: 12px; font-weight: 700;
    color: var(--accent);
    margin: 0 0 10px;
  }
  .hero-title {
    font-family: 'Silkscreen', monospace;
    font-weight: 700;
    font-size: clamp(10px, 2.5vw, 32px);
    line-height: 1.15;
    letter-spacing: 0;
    margin: 0;
    white-space: nowrap;
  }
  .hero-title .accent { color: var(--accent); }
  .hero-lede {
    font-size: 16px; line-height: 1.5; font-weight: 500;
    color: var(--muted);
    max-width: 62ch;
    margin: 14px 0 0;
  }
  .hero-lede strong { color: var(--accent); font-weight: 700; }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-num {
    font-family: var(--f-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .stat-sep {
    color: var(--faint);
    font-size: 1.25rem;
    line-height: 1;
    align-self: center;
  }

  .hero-actions {
    display: flex; flex-wrap: wrap; gap: 11px;
    margin-top: 20px;
  }
  .btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 18px;
    border-radius: 6px;
    border: 1.5px solid var(--ink);
    font-family: var(--f-body);
    font-weight: 700; font-size: 14px;
    box-shadow: 3px 3px 0 var(--shadow);
    transition: transform .1s, box-shadow .1s;
    text-decoration: none;
  }
  .btn:hover {
    box-shadow: 1px 1px 0 var(--shadow);
    transform: translate(2px, 2px);
    text-decoration: none;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-ghost   { background: var(--paper);  color: var(--ink); }

  /* Sections */
  .section-header { margin-bottom: 1.75rem; }
  .section-header h2 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }
  .mono-prefix { color: var(--text-dim); }
  .section-header p { font-size: 0.85rem; color: var(--text-muted); }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.875rem;
  }

  /* Ver más */
  .see-more {
    margin-top: 1.25rem;
    text-align: right;
  }
  .see-more a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.03em;
    transition: opacity .15s;
  }
  .see-more a:hover { opacity: .7; text-decoration: none; }

  /* Newsletter */
  .newsletter-section {
    border: 2px solid var(--accent);
    border-radius: 12px;
    background: var(--card);
    padding: 2rem;
    margin-top: 1.5rem;
    box-shadow: 4px 4px 0 var(--accent);
  }
  .newsletter-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .newsletter-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }
  .newsletter-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .newsletter-input {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.55em 1em;
    color: var(--text);
    flex: 1;
    min-width: 200px;
    outline: none;
    transition: border-color 0.15s;
  }
  .newsletter-input:focus { border-color: var(--accent); }
  .newsletter-input::placeholder { color: var(--text-dim); }
  .newsletter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--accent);
    color: var(--bg);
    padding: 0.55em 1.4em;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .newsletter-btn:hover { opacity: 0.85; }
  .newsletter-btn:disabled { opacity: 0.5; cursor: default; }
  .newsletter-msg {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    min-height: 1.2em;
  }

  /* CTA */
  .cta-section {
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .cta-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Submit nudge */
  .submit-nudge {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
    margin-bottom: 0.5rem;
  }
  .nudge-text {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .nudge-link {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.03em;
    transition: opacity .15s;
  }
  .nudge-link:hover { opacity: .7; text-decoration: none; }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = await getCollection('projects');
const visible = all.filter(p => {
  if (p.data.status === 'archived') return false;
  const d = p.data.description.trim();
  return d !== '' && d.toLowerCase() !== p.data.name.toLowerCase();
});

const newborns = visible
  .filter(p => p.data.status === 'newborn')
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .slice(0, 9);

const thriving = visible
  .filter(p => p.data.status === 'thriving')
  .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore)
  .slice(0, 9);

const watched = visible
  .filter(p => p.data.status === 'watched')
  .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore)
  .slice(0, 9);

const hiddenGems = visible
  .filter(p => p.data.tags.includes('hidden_gem') && p.data.status !== 'thriving')
  .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore)
  .slice(0, 9);

const quiet = visible
  .filter(p => p.data.status === 'quiet')
  .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore)
  .slice(0, 9);

const revived = visible
  .filter(p => p.data.status === 'revived')
  .sort((a, b) => b.data.undervaluedScore - a.data.undervaluedScore)
  .slice(0, 9);

const base = import.meta.env.BASE_URL;

// global stats
const totalProjects  = visible.length;
const totalThriving  = visible.filter(p => p.data.status === 'thriving').length;
const totalNewborn   = visible.filter(p => p.data.status === 'newborn').length;
const totalStars     = visible.reduce((sum, p) => sum + (p.data.stars ?? 0), 0);
const starsDisplay   = totalStars >= 1000
  ? `${(totalStars / 1000).toFixed(1)}k`
  : String(totalStars);
---
<Base title="SilentStars">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">// open source is more than stars</p>
      <h1 class="headline">Not famous. Not abandoned. Just building.</h1>
      <p class="hero-sub">
        SilentStars tracks <strong>{totalProjects}</strong> open source projects that are actively built but chronically undervalued.
        No hype. No trending algorithms. Just signal.
      </p>
      <div class="hero-actions">
        <a href={`${base}projects/`} class="btn-primary">Browse the directory</a>
        <a href={`${base}submit/`} class="btn-ghost">Submit a project →</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-num">{totalProjects}</span>
          <span class="stat-label">projects tracked</span>
        </div>
        <div class="stat-sep">·</div>
        <div class="stat">
          <span class="stat-num">{totalThriving}</span>
          <span class="stat-label">thriving now</span>
        </div>
        <div class="stat-sep">·</div>
        <div class="stat">
          <span class="stat-num">{totalNewborn}</span>
          <span class="stat-label">newborn</span>
        </div>
        <div class="stat-sep">·</div>
        <div class="stat">
          <span class="stat-num">★ {starsDisplay}</span>
          <span class="stat-label">combined stars</span>
        </div>
      </div>
    </div>
  </section>

  {newborns.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Newborn · just started</h2>
        <p>Born in the last 2 months, committed in the last 2 weeks — fragile, alive, and worth watching.</p>
      </div>
      <div class="grid">
        {newborns.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {thriving.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Thriving Now</h2>
        <p>Committed in the last 2 weeks — ranked by undervalued score.</p>
      </div>
      <div class="grid">
        {thriving.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {watched.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Watched</h2>
        <p>More watchers than stars — devs are tracking these before the public notices.</p>
      </div>
      <div class="grid">
        {watched.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {hiddenGems.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Hidden Gems</h2>
        <p>Under 100 stars. Recent activity. Genuine craft. Look closer.</p>
      </div>
      <div class="grid">
        {hiddenGems.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {quiet.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Quiet</h2>
        <p>Still alive, just not loud. Slow cadence, steady craft.</p>
      </div>
      <div class="grid">
        {quiet.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>see more →</a></div>
    </section>
  )}

  {revived.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Revived</h2>
        <p>Back from the dead. Someone cared enough to pick it up again.</p>
      </div>
      <div class="grid">
        {revived.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}resurrections/`}>see more →</a></div>
    </section>
  )}

  <section class="section container newsletter-section">
    <div class="newsletter-inner">
      <div class="newsletter-copy">
        <p class="newsletter-label"><span class="mono-prefix">//</span> stay in the loop</p>
        <p class="newsletter-desc">Weekly hidden gems — one digest, no noise.</p>
      </div>
      <form
        id="newsletter-form"
        class="newsletter-form"
        action="https://buttondown.com/api/emails/embed-subscribe/silentstars"
        method="post"
        target="popupwindow"
      >
        <input type="email" name="email" required placeholder="your@email.com" class="newsletter-input" />
        <input type="hidden" name="embed" value="1" />
        <button type="submit" class="newsletter-btn">Subscribe</button>
      </form>
      <p id="newsletter-msg" class="newsletter-msg" aria-live="polite"></p>
    </div>
  </section>

  <section class="section container cta-section">
    <p class="cta-text">→ see all {visible.length} projects in the directory</p>
    <a href={`${base}projects`} class="btn-primary">Open directory</a>
  </section>
</Base>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const msg  = document.getElementById('newsletter-msg') as HTMLParagraphElement;

  form?.addEventListener('submit', () => {
    window.open('https://buttondown.com/silentstars', 'popupwindow');
    msg.textContent = '✓ Complete the verification in the window that opened.';
  });
</script>

<style>
  /* Hero */
  .hero {
    padding: 1.5rem 0 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 0.6rem;
  }
  .headline {
    font-size: clamp(1.35rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 58ch;
    margin-bottom: 1.25rem;
  }
  .hero-sub strong { color: var(--accent); font-weight: 700; }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-num {
    font-family: var(--f-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .stat-sep {
    color: var(--faint);
    font-size: 1.25rem;
    line-height: 1;
    align-self: center;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn-primary {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--text);
    color: var(--bg);
    padding: 0.6em 1.4em;
    border-radius: var(--radius);
    transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; text-decoration: none; }
  .btn-ghost {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    transition: color 0.15s;
    letter-spacing: 0.02em;
  }
  .btn-ghost:hover { color: var(--text); text-decoration: none; }

  /* Sections */
  .section-header { margin-bottom: 1.75rem; }
  .section-header h2 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }
  .mono-prefix { color: var(--text-dim); }
  .section-header p { font-size: 0.85rem; color: var(--text-muted); }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.875rem;
  }

  /* Ver más */
  .see-more {
    margin-top: 1.25rem;
    text-align: right;
  }
  .see-more a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.03em;
    transition: opacity .15s;
  }
  .see-more a:hover { opacity: .7; text-decoration: none; }

  /* Newsletter */
  .newsletter-section {
    border-top: 1px solid var(--border);
  }
  .newsletter-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .newsletter-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }
  .newsletter-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .newsletter-input {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.55em 1em;
    color: var(--text);
    flex: 1;
    min-width: 200px;
    outline: none;
    transition: border-color 0.15s;
  }
  .newsletter-input:focus { border-color: var(--accent); }
  .newsletter-input::placeholder { color: var(--text-dim); }
  .newsletter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--accent);
    color: var(--bg);
    padding: 0.55em 1.4em;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .newsletter-btn:hover { opacity: 0.85; }
  .newsletter-btn:disabled { opacity: 0.5; cursor: default; }
  .newsletter-msg {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    min-height: 1.2em;
  }

  /* CTA */
  .cta-section {
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .cta-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
</style>

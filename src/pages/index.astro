---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = await getCollection('projects');
const visible = all.filter(p => p.data.status !== 'archived');

const newborns = visible
  .filter(p => p.data.status === 'newborn')
  .sort((a, b) => new Date(b.data.createdAt).getTime() - new Date(a.data.createdAt).getTime())
  .slice(0, 9);

const thriving = visible
  .filter(p => p.data.status === 'thriving')
  .sort((a, b) => b.data.attentionGap - a.data.attentionGap)
  .slice(0, 9);

const hiddenGems = visible
  .filter(p => p.data.tags.includes('hidden_gem') && p.data.status !== 'thriving')
  .sort((a, b) => b.data.attentionGap - a.data.attentionGap)
  .slice(0, 9);

const quiet = visible
  .filter(p => p.data.status === 'quiet')
  .sort((a, b) => b.data.attentionGap - a.data.attentionGap)
  .slice(0, 9);

const atRisk = visible
  .filter(p => p.data.status === 'at_risk')
  .sort((a, b) => b.data.attentionGap - a.data.attentionGap)
  .slice(0, 9);

const revived = visible
  .filter(p => p.data.status === 'revived')
  .sort((a, b) => b.data.attentionGap - a.data.attentionGap)
  .slice(0, 9);

const base = import.meta.env.BASE_URL;

// global stats
const totalProjects  = visible.length;
const totalThriving  = visible.filter(p => p.data.status === 'thriving').length;
const totalAtRisk    = visible.filter(p => p.data.status === 'at_risk').length;
const totalNewborn   = visible.filter(p => p.data.status === 'newborn').length;
const totalStars     = visible.reduce((sum, p) => sum + (p.data.stars ?? 0), 0);
const starsDisplay   = totalStars >= 1000
  ? `${(totalStars / 1000).toFixed(1)}k`
  : String(totalStars);
---
<Base title="SilentStars">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">// open source is more than stars</p>
      <h1 class="headline">Not famous. Not abandoned. Just building.</h1>
      <div class="hero-actions">
        <a href={`${base}projects`} class="btn-primary">Browse the directory</a>
        <a href={`${base}at-risk`} class="btn-ghost">At risk →</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">{totalProjects}</span>
          <span class="stat-label">projects</span>
        </div>
        <div class="stat-divider" aria-hidden="true">/</div>
        <div class="stat">
          <span class="stat-value">{totalThriving}</span>
          <span class="stat-label">thriving</span>
        </div>
        <div class="stat-divider" aria-hidden="true">/</div>
        <div class="stat">
          <span class="stat-value">{totalNewborn}</span>
          <span class="stat-label">newborn</span>
        </div>
        <div class="stat-divider" aria-hidden="true">/</div>
        <div class="stat">
          <span class="stat-value stat-risk">{totalAtRisk}</span>
          <span class="stat-label">at risk</span>
        </div>
        <div class="stat-divider" aria-hidden="true">/</div>
        <div class="stat">
          <span class="stat-value">★ {starsDisplay}</span>
          <span class="stat-label">total stars</span>
        </div>
      </div>
    </div>
  </section>

  {newborns.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Newborn · just started</h2>
        <p>Projects born in the last 6 months — fragile, alive, and worth watching.</p>
      </div>
      <div class="grid">
        {newborns.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>ver más →</a></div>
    </section>
  )}

  {thriving.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Thriving Now</h2>
        <p>Active projects shipping code — ranked by how undervalued they are.</p>
      </div>
      <div class="grid">
        {thriving.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>ver más →</a></div>
    </section>
  )}

  {hiddenGems.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Hidden Gems</h2>
        <p>Under 100 stars. Recent activity. Genuine craft. Look closer.</p>
      </div>
      <div class="grid">
        {hiddenGems.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>ver más →</a></div>
    </section>
  )}

  {quiet.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Quiet</h2>
        <p>Still alive, just not loud. Slow cadence, steady craft.</p>
      </div>
      <div class="grid">
        {quiet.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}projects/`}>ver más →</a></div>
    </section>
  )}

  {atRisk.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> At Risk</h2>
        <p>Fading signal. Worth a star, a PR, or just a look.</p>
      </div>
      <div class="grid">
        {atRisk.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}at-risk/`}>ver más →</a></div>
    </section>
  )}

  {revived.length > 0 && (
    <section class="section container">
      <div class="section-header">
        <h2><span class="mono-prefix">//</span> Revived</h2>
        <p>Back from the dead. Someone cared enough to pick it up again.</p>
      </div>
      <div class="grid">
        {revived.map(p => (
          <ProjectCard slug={p.slug} {...p.data} />
        ))}
      </div>
      <div class="see-more"><a href={`${base}resurrections/`}>ver más →</a></div>
    </section>
  )}

  <section class="section container cta-section">
    <p class="cta-text">→ see all {visible.length} projects in the directory</p>
    <a href={`${base}projects`} class="btn-primary">Open directory</a>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: 1.5rem 0 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 0.6rem;
  }
  .headline {
    font-size: clamp(1.35rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .stat-value {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }
  .stat-risk { color: var(--at-risk); }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .stat-divider {
    font-family: var(--f-mono);
    font-size: 1rem;
    color: var(--border);
    align-self: center;
    padding-bottom: 14px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn-primary {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--text);
    color: var(--bg);
    padding: 0.6em 1.4em;
    border-radius: var(--radius);
    transition: opacity 0.15s;
  }
  .btn-primary:hover { opacity: 0.85; text-decoration: none; }
  .btn-ghost {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    transition: color 0.15s;
    letter-spacing: 0.02em;
  }
  .btn-ghost:hover { color: var(--text); text-decoration: none; }

  /* Sections */
  .section-header { margin-bottom: 1.75rem; }
  .section-header h2 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
    letter-spacing: -0.01em;
  }
  .mono-prefix { color: var(--text-dim); }
  .section-header p { font-size: 0.85rem; color: var(--text-muted); }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.875rem;
  }

  /* Ver más */
  .see-more {
    margin-top: 1.25rem;
    text-align: right;
  }
  .see-more a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.03em;
    transition: opacity .15s;
  }
  .see-more a:hover { opacity: .7; text-decoration: none; }

  /* CTA */
  .cta-section {
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .cta-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
</style>

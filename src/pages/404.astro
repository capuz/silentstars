---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
// Live slugs let the page fix casing / owner-repo links instead of dead-ending.
const slugs = (await getCollection('projects')).map(p => p.slug);
---
<Base title="404" description="Page not found — SilentStars" notFound>
  <div class="container section not-found" id="nf" data-slugs={JSON.stringify(slugs)}>

    <p class="eyebrow">// 404</p>
    <h1 class="nf-title" id="nf-title">Star not found</h1>
    <p class="nf-sub" id="nf-sub">
      This repo may have been deleted, renamed, or the link is broken.
    </p>

    <div class="nf-actions">
      <a href={`${base}`} class="btn-primary">← Home</a>
      <a href="#" class="btn-primary" id="nf-github" hidden>Find it on GitHub ↗</a>
      <a href={`${base}projects/`} class="btn-ghost">Browse directory</a>
    </div>

    <div class="nf-star" aria-hidden="true">★</div>

  </div>
</Base>

<script>
  import { resolveNotFound } from '../../scripts/not-found.ts';

  type GoatCounter = { count?: (o: { path: string; title?: string; event?: boolean }) => void };

  // count.js loads async with no_onload (see Base.astro notFound): wait for it,
  // but never hold a redirect hostage to a blocked analytics script.
  function count(opts: { path: string; title?: string; event?: boolean }): Promise<void> {
    return new Promise(resolve => {
      const send = () => { (window as unknown as { goatcounter?: GoatCounter }).goatcounter?.count?.(opts); resolve(); };
      if ((window as unknown as { goatcounter?: GoatCounter }).goatcounter?.count) return send();
      document.getElementById('gc-script')?.addEventListener('load', send);
      setTimeout(resolve, 1000);
    });
  }

  const root = document.getElementById('nf')!;
  const live = new Set<string>(JSON.parse(root.dataset.slugs ?? '[]'));
  const { pathname, search, hash } = location;
  const res = resolveNotFound(pathname, live);

  if (res.kind === 'redirect') {
    count({ path: `404-redirect${pathname}`, title: `→ ${res.to}`, event: true })
      .then(() => location.replace(res.to + search + hash));
  } else {
    if (res.kind === 'retired') {
      document.getElementById('nf-title')!.textContent = 'This star left the map';
      document.getElementById('nf-sub')!.textContent =
        `${res.owner}/${res.repoHint} is no longer in the directory — projects drop out when they stop meeting the criteria. The repo itself may still be on GitHub.`;
      const gh = document.getElementById('nf-github') as HTMLAnchorElement;
      gh.href = `https://github.com/${res.owner}?tab=repositories&q=${encodeURIComponent(res.repoHint)}`;
      gh.target = '_blank';
      gh.rel = 'noopener';
      gh.hidden = false;
      root.querySelector('.btn-primary')!.classList.replace('btn-primary', 'btn-ghost');
    }
    count({ path: `/404${pathname}`, title: res.kind === 'retired' ? '404 retired project' : '404 unknown' });
  }
</script>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
    position: relative;
    overflow: hidden;
  }

  .eyebrow {
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: .08em;
    margin: 0 0 12px;
  }

  .nf-title {
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 16px;
    line-height: 1.1;
  }

  .nf-sub {
    font-family: var(--f-body);
    font-size: 1.05rem;
    color: var(--ink);
    opacity: .6;
    max-width: 420px;
    margin: 0 0 40px;
    line-height: 1.6;
  }

  .nf-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 22px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    border: 2px solid var(--ink);
    transition: background .12s, color .12s;
  }
  .btn-primary:hover { background: var(--accent); border-color: var(--accent); text-decoration: none; }

  .btn-ghost {
    font-family: var(--f-mono);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 22px;
    background: transparent;
    color: var(--ink);
    border-radius: 999px;
    border: 2px solid var(--ink);
    transition: background .12s, color .12s;
  }
  .btn-ghost:hover { background: var(--ink); color: var(--paper); text-decoration: none; }

  .nf-star {
    position: absolute;
    bottom: -1rem;
    right: 2rem;
    font-size: clamp(6rem, 18vw, 12rem);
    color: var(--ink);
    opacity: .04;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    font-family: var(--f-display);
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';

const all = await getCollection('projects');
const revived = all
  .filter(p => p.data.status === 'revived')
  .sort((a, b) => (a.data.revivedDaysAgo ?? 999) - (b.data.revivedDaysAgo ?? 999));

const base = import.meta.env.BASE_URL;
---
<Base
  title="Resurrections"
  description="Open source projects that came back from the edge. Inactive for months — now building again."
>
  <div class="container section">
    <header class="page-header">
      <p class="eyebrow">// revived</p>
      <h1>They came back</h1>
      <p class="lead">
        These projects went quiet for months — sometimes over a year.
        Then something happened: a new maintainer, a renewed burst of energy,
        a community that refused to let it die.
      </p>
      <p class="lead">
        Proof that open source doesn't have to end just because it paused.
      </p>
    </header>

    {revived.length === 0 ? (
      <p class="empty">// no revivals tracked yet. check back soon.</p>
    ) : (
      <ul class="revival-list">
        {revived.map(p => (
          <li class="revival-item">
            <div class="revival-header">
              <a href={`${base}projects/${p.slug}/`} class="revival-name">
                {p.data.name}
              </a>
              <StatusBadge status="revived" />
            </div>

            <p class="revival-story">
              <span class="story-dormant">
                inactive for {p.data.revivedAfterMonths ?? '?'} month{(p.data.revivedAfterMonths ?? 0) !== 1 ? 's' : ''}
              </span>
              {' → '}
              <span class="story-alive">
                back to life {p.data.revivedDaysAgo != null
                  ? `${p.data.revivedDaysAgo}d ago`
                  : 'recently'
                }
              </span>
            </p>

            <p class="revival-desc">{p.data.description}</p>

            <div class="revival-footer">
              <a href={p.data.url} target="_blank" rel="noopener" class="gh-link">
                {p.data.repo} ↗
              </a>
              <span class="stars">★ {p.data.stars}</span>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--revived);
    margin-bottom: 0.75rem;
    letter-spacing: 0.04em;
  }
  .page-header { max-width: 660px; margin-bottom: 3rem; }
  .page-header h1 { font-size: 1.75rem; margin-bottom: 1.25rem; letter-spacing: -0.02em; }
  .lead {
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 0.75rem;
    font-size: 0.925rem;
  }

  .revival-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 680px;
  }

  .revival-item {
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 2px solid var(--revived);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.2s;
  }
  .revival-item:hover { border-color: var(--revived); }

  .revival-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .revival-name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .revival-name:hover { color: var(--revived); text-decoration: none; }

  .revival-story {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }
  .story-dormant { color: var(--text-dim); }
  .story-alive { color: var(--revived); font-weight: 700; }

  .revival-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.65; }

  .revival-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  .gh-link { color: var(--text-dim); }
  .gh-link:hover { color: var(--text); text-decoration: none; }
  .stars { opacity: 0.5; }

  .empty {
    font-family: var(--font-mono);
    color: var(--text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
</style>

---
import StatusBadge from './StatusBadge.astro';
import VitalityBar from './VitalityBar.astro';

interface Props {
  slug: string;
  name: string;
  description: string;
  repo: string;
  url: string;
  status: 'thriving' | 'quiet' | 'at_risk' | 'newborn' | 'revived' | 'archived';
  tags: string[];
  vitalityScore: number;
  attentionGap: number;
  stars: number;
  language?: string;
  lastCommitAt: string;
}

const {
  slug, name, description, repo, url, status, tags,
  vitalityScore, attentionGap, stars, language, lastCommitAt
} = Astro.props;

const base = import.meta.env.BASE_URL;

const tagLabels: Record<string, string> = {
  solo_builder:       '// solo',
  needs_contributors: '// help wanted',
  hidden_gem:         '// hidden gem',
  legacy_hero:        '// legacy',
};

const statusVar: Record<string, string> = {
  thriving: 'var(--thriving)',
  quiet:    'var(--quiet)',
  at_risk:  'var(--at-risk)',
  newborn:  'var(--newborn)',
  revived:  'var(--revived)',
  archived: 'var(--archived)',
};

const daysSince = Math.floor((Date.now() - new Date(lastCommitAt).getTime()) / 86_400_000);
const lastCommitLabel = daysSince === 0 ? 'today' : daysSince === 1 ? 'yesterday' : `${daysSince}d ago`;
---
<article class="card" style={`--status-color: ${statusVar[status]}`}>
  <div class="card-top">
    <div class="card-meta">
      <StatusBadge status={status} />
      {language && <span class="lang">{language}</span>}
    </div>
    <div class="gap-score" title="Attention Gap — higher means more undervalued">
      ↑{attentionGap.toFixed(1)}
    </div>
  </div>

  <a href={`${base}projects/${slug}`} class="card-title-link">
    <h3 class="card-title">{name}</h3>
  </a>
  <p class="card-repo">{repo}</p>
  <p class="card-desc">{description}</p>

  <div class="vitality">
    <VitalityBar score={vitalityScore} />
  </div>

  {tags.length > 0 && (
    <ul class="tags">
      {tags.map(t => <li class="tag">{tagLabels[t] ?? t}</li>)}
    </ul>
  )}

  <div class="card-footer">
    <span class="last-commit">{lastCommitLabel}</span>
    <a href={url} target="_blank" rel="noopener" class="stars">★ {stars}</a>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
    overflow: hidden;
  }

  /* Pixel corner accent — top-left, takes status color on hover */
  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 6px; height: 6px;
    background: var(--border);
    transition: background 0.2s;
  }
  /* Pixel corner accent — bottom-right */
  .card::after {
    content: '';
    position: absolute;
    bottom: 0; right: 0;
    width: 4px; height: 4px;
    background: var(--border);
    transition: background 0.2s, opacity 0.2s;
    opacity: 0;
  }

  .card:hover {
    border-color: var(--status-color);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
  }
  .card:hover::before {
    background: var(--status-color);
    animation: pixel-blink 0.5s steps(1) infinite;
  }
  .card:hover::after {
    background: var(--status-color);
    opacity: 0.4;
  }

  @keyframes pixel-blink { 50% { opacity: 0; } }

  /* Top row */
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .card-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .lang {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    padding: 0.15em 0.5em;
    border: 1px solid var(--border);
    border-radius: 2px;
    letter-spacing: 0.04em;
  }
  .gap-score {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* Title */
  .card-title-link:hover { text-decoration: none; }
  .card-title {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  .card:hover .card-title { color: var(--status-color); }

  .card-repo {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    margin-top: -0.5rem;
    letter-spacing: 0.02em;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }

  /* Tags */
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-dim);
    letter-spacing: 0.03em;
  }

  /* Footer */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
  }
  .stars { opacity: 0.5; transition: opacity 0.15s; }
  .stars:hover { opacity: 1; text-decoration: none; }
</style>

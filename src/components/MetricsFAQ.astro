---
const items = [
  {
    glyph: '↑',
    q: 'The Undervalued Score',
    a: 'How much attention a project earns versus how much it actually gets. Higher means more overlooked — real momentum that the star count hasn\'t caught up with yet. Normalised to 0–100; above 50 means the work is outrunning its audience.',
    body: `score  = signal / reach

signal = 0.40·commit_velocity   // commits in last 90 days
       + 0.25·contributor_work  // unique authors × activity
       + 0.20·issue_response    // closed ÷ total issues
       + 0.15·release_cadence   // tagged releases in 90 days

reach  = log₁₀(stars + watchers + 1)`,
  },
  {
    glyph: '♥',
    q: 'The Health Score',
    a: 'Is the project alive and maintained right now? A 0–100 pulse recomputed nightly from commit recency, rhythm, how fast issues close, and how quickly PRs get merged.',
    body: `health = 0.35·recency       // days since last commit
       + 0.25·cadence       // commit rhythm consistency
       + 0.20·issue_health  // closed ÷ total issues
       + 0.20·pr_health     // merged ÷ total PRs`,
  },
  {
    glyph: '◷',
    q: 'Health bands',
    a: 'The colour and label on every card come straight from the health score.',
    body: `Healthy   80 – 100   active, responsive, regular releases
Stable    60 – 79    maintained, steady, no alarms
Quiet     40 – 59    slowing down — watch this one
At Risk    0 – 39    going dark · candidate for rescue`,
  },
  {
    glyph: '★',
    q: 'Why rank against stars at all?',
    a: 'Stars are an outcome, not effort. A project with 8 stars and daily commits is doing more interesting work than one coasting on 8k. We measure the building, then divide by the attention already received — so the genuinely undervalued rise to the top.',
    body: `// stars   = lagging indicator
// commits = leading indicator
// we rank by the leading one`,
  },
];
---

<div class="faq">
  {items.map(it => (
    <details>
      <summary>
        <span class="faq-head">
          <span class="faq-glyph">{it.glyph}</span>
          <span class="faq-q">{it.q}</span>
        </span>
        <span class="ss-plus">+</span>
      </summary>
      <div class="faq-body">
        <p>{it.a}</p>
        <pre class="term">{it.body}<span class="term-cursor">█</span></pre>
      </div>
    </details>
  ))}
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 40px 30px;
  }

  details {
    border: 1.5px solid var(--ink);
    border-radius: 7px;
    background: var(--paper);
    box-shadow: 2px 2px 0 var(--shadow);
  }

  details > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 13px;
  }
  details > summary::-webkit-details-marker { display: none; }

  .faq-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .faq-glyph {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: 14px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .faq-q {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 13.5px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .ss-plus {
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    flex-shrink: 0;
    transition: transform 0.2s;
    line-height: 1;
  }
  details[open] .ss-plus {
    transform: rotate(45deg);
  }

  .faq-body {
    padding: 0 13px 13px;
  }

  .faq-body p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .term {
    font-family: 'Space Mono', monospace;
    font-size: 11.5px;
    line-height: 1.7;
    color: #5dffa0;
    text-shadow: 0 0 5px rgba(94, 255, 160, 0.4);
    background: #0d140f;
    border: 1.5px solid rgba(94, 255, 160, 0.28);
    border-radius: 6px;
    padding: 11px 13px;
    box-shadow: inset 0 0 24px rgba(94, 255, 160, 0.08);
    white-space: pre;
    overflow-x: auto;
    margin: 0;
  }

  .term-cursor {
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>

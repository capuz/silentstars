---
import { faqItems as items } from '../lib/metrics-faq.ts';
---

<div class="faq-wrap">
<div class="faq">
  {items.map(it => (
    <details id={it.id}>
      <summary>
        <span class="faq-head">
          <span class="faq-glyph">{it.glyph}</span>
          <span class="faq-q">{it.q}</span>
        </span>
        <span class="ss-plus">+</span>
      </summary>
      <div class="faq-body">
        <p>{it.a}</p>
        <pre class="term">{it.body}<span class="term-cursor">█</span></pre>
      </div>
    </details>
  ))}
  </div>
</div>

<style>
  .faq-wrap {
    width: 100%;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: var(--max-w);
    width: 100%;
    margin: 0 auto;
    padding: 40px 30px;
    box-sizing: border-box;
  }

  details {
    scroll-margin-top: 80px; /* clear the sticky nav when opened from a ScoreHelp link */
    border: 1.5px solid var(--ink);
    border-radius: 7px;
    background: var(--paper);
    box-shadow: 2px 2px 0 var(--shadow);
  }

  details > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 13px;
  }
  details > summary::-webkit-details-marker { display: none; }

  .faq-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .faq-glyph {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: 14px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .faq-q {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 13.5px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .ss-plus {
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    flex-shrink: 0;
    transition: transform 0.2s;
    line-height: 1;
  }
  details[open] .ss-plus {
    transform: rotate(45deg);
  }

  .faq-body {
    padding: 0 13px 13px;
  }

  .faq-body p {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 10px;
  }

  .term {
    font-family: 'Space Mono', monospace;
    font-size: 11.5px;
    line-height: 1.7;
    color: #5dffa0;
    text-shadow: 0 0 5px rgba(94, 255, 160, 0.4);
    background: #0d140f;
    border: 1.5px solid rgba(94, 255, 160, 0.28);
    border-radius: 6px;
    padding: 11px 13px;
    box-shadow: inset 0 0 24px rgba(94, 255, 160, 0.08);
    white-space: pre;
    overflow-x: auto;
    margin: 0;
  }

  .term-cursor {
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>

<!-- open the item a ScoreHelp link points at (/about/#health etc.) -->
<script>
  function openFromHash() {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>

---
interface Props { score: number; }
const { score } = Astro.props;

const band =
  score >= 80 ? { label: 'Healthy',  cls: 'healthy',  icon: '█' } :
  score >= 60 ? { label: 'Stable',   cls: 'stable',   icon: '▓' } :
  score >= 40 ? { label: 'Quiet',    cls: 'quiet',    icon: '▒' } :
                { label: 'At Risk',  cls: 'at-risk',  icon: '░' };
---
<div class="vitality-wrap" title={`Vitality: ${score}/100 · ${band.label}`}>
  <div class="bar-track">
    <div class={`bar-fill bar-fill--${band.cls}`} style={`width:${score}%`}></div>
  </div>
  <span class="label">
    <span class="icon" aria-hidden="true">{band.icon}</span>
    <span class="score">{score}</span>
    <span class="band-name">/ {band.label}</span>
  </span>
</div>

<style>
  .vitality-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .bar-track {
    flex: 1;
    height: 3px;
    background: #2a2535;
    overflow: hidden;
    min-width: 50px;
  }
  .bar-fill {
    height: 100%;
    transition: width 0.3s;
  }
  .bar-fill--healthy { background: var(--thriving); }
  .bar-fill--stable  { background: var(--quiet); }
  .bar-fill--quiet   { background: var(--at-risk); }
  .bar-fill--at-risk { background: #ff4d4d; }

  .label {
    display: flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    white-space: nowrap;
  }
  .icon { font-size: 0.5rem; }
  .score { color: var(--text-muted); }
  .band-name { color: var(--text-dim); }
</style>

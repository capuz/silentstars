---
interface Props { score: number; }
const { score } = Astro.props;

const band =
  score >= 80 ? { label: 'Healthy',  cls: 'healthy',  icon: '🟢' } :
  score >= 60 ? { label: 'Stable',   cls: 'stable',   icon: '🟡' } :
  score >= 40 ? { label: 'Quiet',    cls: 'quiet',    icon: '🟠' } :
                { label: 'At Risk',  cls: 'at-risk',  icon: '🔴' };
---
<div class="vitality-wrap" title={`Vitality Score: ${score}/100 · ${band.label}`}>
  <div class="bar-track">
    <div class={`bar-fill bar-fill--${band.cls}`} style={`width:${score}%`}></div>
  </div>
  <span class="label">
    <span aria-hidden="true">{band.icon}</span>
    {score}
    <span class="band-name">· {band.label}</span>
  </span>
</div>

<style>
  .vitality-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .bar-track {
    flex: 1;
    height: 4px;
    background: #2a2a2a;
    border-radius: 2px;
    overflow: hidden;
    min-width: 60px;
  }
  .bar-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.3s;
  }
  .bar-fill--healthy { background: #4ade80; }
  .bar-fill--stable  { background: #facc15; }
  .bar-fill--quiet   { background: #fb923c; }
  .bar-fill--at-risk { background: #f87171; }

  .label {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .band-name { color: var(--text-dim); }
</style>
